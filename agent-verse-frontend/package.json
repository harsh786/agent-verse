{
  "name": "agent-verse-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "lint": "eslint src --ext ts,tsx",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --dir src",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:update-snapshots": "playwright test e2e/visual-regression.spec.ts --update-snapshots",
    "test:e2e:snapshots": "CI=true playwright test e2e/visual-regression.spec.ts",
    "test:e2e:build": "playwright test --config=playwright.build.config.ts"
  },
  "dependencies": {
    "@codemirror/collab": "^6.1.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@tanstack/react-query": "5.80.7",
    "@tanstack/react-query-devtools": "5.80.7",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.11",
    "@types/diff": "^7.0.2",
    "@uiw/react-codemirror": "^4.25.10",
    "@xyflow/react": "^12.11.1",
    "clsx": "2.1.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "diff": "^9.0.0",
    "framer-motion": "^13.1.0",
    "html-to-image": "1.11.13",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "js-yaml": "^4.3.2",
    "lucide-react": "0.511.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.85.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-router-dom": "7.6.2",
    "recharts": "2.15.3",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "y-codemirror.next": "^0.3.5",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31",
    "zustand": "5.0.5"
