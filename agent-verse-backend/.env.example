# Copy to .env for local development. In production, prefer *_FILE mounted secrets.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Reverse proxies whose X-Forwarded-For / X-Real-IP is believed (IPs/CIDRs,
# comma-separated, e.g. the ingress controller pod CIDR). Empty = trust none.
# TRUSTED_PROXIES=

# Infrastructure DSNs (match docker-compose service names when running in compose)
# Three database roles (see app/db/app_role.py):
#   DATABASE_URL             the API/workers' least-privilege APPLICATION role
#                            (NOSUPERUSER, NOBYPASSRLS -> row-level security binds).
#                            Never point it at a superuser: RLS is bypassed and
#                            tenants see each other's rows.
#   MAINTENANCE_DATABASE_URL BYPASSRLS role for cross-tenant system jobs only.
#   MIGRATION_DATABASE_URL   schema owner alembic migrates with (empty = DATABASE_URL).
DATABASE_URL=postgresql+asyncpg://agentverse_app:agentverse_app@localhost:5432/agentverse
MAINTENANCE_DATABASE_URL=postgresql+asyncpg://agentverse:agentverse@localhost:5432/agentverse
MIGRATION_DATABASE_URL=postgresql+asyncpg://agentverse:agentverse@localhost:5432/agentverse
# `alembic upgrade head` creates/repairs this role (and its grants) after migrating
# when APP_DB_USER is set. Production refuses the dev-default password. The compose
# stack reads APP_DB_USER / APP_DB_PASSWORD from the shell or infra/.env (compose
# interpolation), not from this file — change them there, and keep them URL-safe.
APP_DB_USER=agentverse_app
APP_DB_PASSWORD=agentverse_app
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO for local dev, S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# SSO / Keycloak (postgres-backed for persistent state)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agentverse
KEYCLOAK_CLIENT_ID=agentverse-backend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_DB_PASSWORD=keycloak
SSO_ENABLED=false

# Observability (leave OTEL endpoint empty to disable exporting locally)
SERVICE_NAME=agentverse-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── LLM providers (set at least one for real goal execution) ────────────────
DEFAULT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...     # Voyage AI for best RAG embeddings
# GOOGLE_API_KEY=...        # Gemini embeddings
# SENTENCE_TRANSFORMERS_MODEL=all-mpnet-base-v2  # local CPU embeddings (768-d; no API key).
#   The model must output 768/1024/1536/2048/3072 dims (all-MiniLM-L6-v2 is 384-d: unsupported).

# ── A2A (Agent-to-Agent) protocol ───────────────────────────────────────────
# A2A_TENANT_ID=            # REQUIRED for the /a2a/tasks endpoint to work
# A2A_SHARED_SECRET=        # HMAC-SHA256 signing secret; empty = auth disabled (dev only)

# ── Slack integration ────────────────────────────────────────────────────────
# SLACK_TENANT_ID=          # tenant_id for goals triggered via Slack
# SLACK_SIGNING_SECRET=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APPROVAL_CHANNEL=hitl-approvals

# ── Inbound channel webhooks (/channels/*) — fail closed when unset ─────────
# Slack uses SLACK_SIGNING_SECRET; Teams uses TEAMS_APP_ID (Bot Framework JWT);
# Discord uses DISCORD_PUBLIC_KEY (Ed25519). Relay channels need an operator
# secret, sent as X-Webhook-Secret or as the HTTP Basic password in the URL.
# CHANNEL_WEBHOOK_SECRET_EMAIL=
# CHANNEL_WEBHOOK_SECRET_SMS=
# CHANNEL_WEBHOOK_SECRET_VOICE=
# CHANNEL_WEBHOOK_SECRET_FORM=
# CHANNEL_WEBHOOK_SECRET_MEETING=

# ── Zapier integration ───────────────────────────────────────────────────────
# ZAPIER_TENANT_ID=         # tenant_id for goals triggered via Zapier
# ZAPIER_WEBHOOK_SECRET=

# ── IMAP email-to-goal listener ─────────────────────────────────────────────
IMAP_ENABLED=false
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=goals@example.com
# IMAP_PASSWORD=
# IMAP_SSL=true
# IMAP_MAILBOX=INBOX
# IMAP_TENANT_ID=
# Required: only these senders (addresses or @domains) may create goals, and only
# with a DKIM/SPF/DMARC pass in the receiving MTA's Authentication-Results.
# IMAP_SENDER_ALLOWLIST=@example.com,ops@partner.example
# IMAP_AUTHSERV_ID=mx.example.com

# ── SMTP outbound email (MailPit for local dev) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_TLS=false

# ── Runtime tuning ───────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=90
AGENTVERSE_DB_SCHEDULE_DISCOVERY=true
EMBEDDING_DIM=1536

# ── MCP Built-in Servers ─────────────────────────────────────────────────────
# GITHUB_TOKEN=
# POSTGRES_MCP_URL=
POSTGRES_MCP_ALLOW_WRITES=false

# ── Shell execution (disabled by default for security) ───────────────────────
AGENTVERSE_ALLOW_SHELL_EXEC=false
AGENTVERSE_ALLOW_SUBPROCESS_EXEC=false

# ── SearXNG ──────────────────────────────────────────────────────────────────
SEARXNG_URL=http://searxng:8080

# ── Production model routing ─────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=anthropic

# ── Voice OS (native STT/TTS — Task 12.1) ─────────────────────────────────────
VOICE_ENABLED=true
VOICE_DEVICE=cpu                         # cpu | cuda
VOICE_STT_PROVIDER=faster_whisper        # faster_whisper | whisper_api | assemblyai
VOICE_TTS_PROVIDER=kokoro               # kokoro | omnivoice | elevenlabs | openai_tts | azure_tts
VOICE_STT_MODEL=tiny                     # small & offline-friendly for local dev; use large-v3-turbo in production
VOICE_TTS_MODEL=k2-fsa/OmniVoice
# MODEL_CACHE_DIR=/app/models            # Docker only — leave unset locally to use ~/.cache/agentverse/models
VOICE_MAX_AUDIO_MB=25
VOICE_GREETING_CACHE_TTL=300

# Optional: voice persona S3 storage (for voice cloning per org)
VOICE_PERSONA_BUCKET=agentverse-voice-personas
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Optional: paid TTS API keys (unused when VOICE_TTS_PROVIDER=kokoro/omnivoice)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=rachel
# OPENAI_TTS_VOICE=nova
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=eastus

# Optional: paid STT API keys (unused when VOICE_STT_PROVIDER=faster_whisper)
# ASSEMBLY_AI_KEY=

# Optional: agent runtime trade-off switches (defaults = shipped behaviour)
# Errored guardrail engine fails closed on EVERY step, not only high-risk ones.
# GUARDRAIL_FAIL_CLOSED_ALL=false
# Risk class of interactive RPA tools (rpa_click/rpa_type/...): write_low | write_high
# RPA_INTERACTION_RISK=write_low
# How often a model with no capability data probes richer execution modes (0..1).
# EXPLORE_RATE_UNKNOWN=1.0

# Optional: owner decisions (defaults = shipped behaviour)
# Shortest gap (seconds) a plan may schedule between fires; beat ticks every 60 s.
# SCHEDULE_MIN_INTERVAL_FREE_S=900
# SCHEDULE_MIN_INTERVAL_STARTER_S=300
# SCHEDULE_MIN_INTERVAL_PROFESSIONAL_S=60
# SCHEDULE_MIN_INTERVAL_ENTERPRISE_S=60
# Repository ingestions one tenant may have queued or running at once.
# REPO_INGEST_MAX_CONCURRENT_PER_TENANT=2
# Collections one federated knowledge search may fan out to.
# KNOWLEDGE_FEDERATED_MAX_COLLECTIONS=20
# Pin connector drivers to egress-checked addresses; drivers that cannot be pinned
# (confluent-kafka / librdkafka) are refused while true.
# INGESTION_EGRESS_STRICT_PINNING=true
# Fully-autonomous agents need an attached eval suite whose latest run passes the gate.
# FULLY_AUTONOMOUS_EVAL_GATE_ENABLED=true
# Supervisor sub-goals run under the parent's concurrent-goal slot (false = own slot).
# SUBGOALS_SHARE_PARENT_SLOT=true
