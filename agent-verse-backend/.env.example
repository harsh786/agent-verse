# Copy to .env for local development. In production, prefer *_FILE mounted secrets.
ENVIRONMENT=development
# Vault master key for tenant BYOK keys / connector secrets. Must be the SAME on
# the API and every worker/beat process (they read it from this file in compose).
# Unset in development = the published dev key (refused outside development/test).
# VAULT_MASTER_KEY=
DEBUG=true
LOG_LEVEL=INFO

CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Reverse proxies whose X-Forwarded-For / X-Real-IP is believed (IPs/CIDRs,
# comma-separated, e.g. the ingress controller pod CIDR). Empty = trust none.
# TRUSTED_PROXIES=

# Infrastructure DSNs (match docker-compose service names when running in compose)
# Three database roles (see app/db/app_role.py):
#   DATABASE_URL             the API/workers' least-privilege APPLICATION role
#                            (NOSUPERUSER, NOBYPASSRLS -> row-level security binds).
#                            Never point it at a superuser: RLS is bypassed and
#                            tenants see each other's rows.
#   MAINTENANCE_DATABASE_URL BYPASSRLS role for cross-tenant system jobs only.
#   MIGRATION_DATABASE_URL   schema owner alembic migrates with (empty = DATABASE_URL).
DATABASE_URL=postgresql+asyncpg://agentverse_app:agentverse_app@localhost:5432/agentverse
MAINTENANCE_DATABASE_URL=postgresql+asyncpg://agentverse:agentverse@localhost:5432/agentverse
MIGRATION_DATABASE_URL=postgresql+asyncpg://agentverse:agentverse@localhost:5432/agentverse
# `alembic upgrade head` creates/repairs this role (and its grants) after migrating
# when APP_DB_USER is set. Production refuses the dev-default password. The compose
# stack reads APP_DB_USER / APP_DB_PASSWORD from the shell or infra/.env (compose
# interpolation), not from this file — change them there, and keep them URL-safe.
APP_DB_USER=agentverse_app
APP_DB_PASSWORD=agentverse_app
# The compose stack's MAINTENANCE_DATABASE_URL user/password come from
# MAINTENANCE_DB_USER / MAINTENANCE_DB_PASSWORD (shell or infra/.env; default the
# owner agentverse/agentverse). A separate BYPASSRLS role set there is also added
# to pgbouncer's auth file (infra/pgbouncer/add-app-user.sh); create the role in
# Postgres yourself (LOGIN BYPASSRLS + DML grants) — nothing provisions it.
REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO for local dev, S3-compatible)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# SSO / Keycloak (postgres-backed for persistent state)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=agentverse
KEYCLOAK_CLIENT_ID=agentverse-backend
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_DB_PASSWORD=keycloak
SSO_ENABLED=false

# Observability (leave OTEL endpoint empty to disable exporting locally)
SERVICE_NAME=agentverse-backend
OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Strategy runtime v2 (explicit goal strategies) ──────────────────────────
# A goal's strategy_override (supervisor, debate, voyager, camel, ...) runs only on
# the v2 runtime. Comma-separated tenant ids, or * for every tenant. A tenant not
# listed runs overrides on the legacy kernel and the goal says so
# (strategy_downgraded: true + reason, a strategy_downgraded event, a warning log).
# STRATEGY_RUNTIME_V2_TENANT_ALLOWLIST=*
# STRATEGY_RUNTIME_V2_KILL_SWITCH=false   # true = refuse explicit strategies
# STRATEGY_RUNTIME_V2_SHADOW=false        # true = compare only, keep the legacy kernel

# ── LLM providers (set at least one for real goal execution) ────────────────
DEFAULT_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# VOYAGE_API_KEY=pa-...     # Voyage AI for best RAG embeddings
# GOOGLE_API_KEY=...        # Gemini embeddings
# SENTENCE_TRANSFORMERS_MODEL=all-mpnet-base-v2  # local CPU embeddings (768-d; no API key).
#   The model must output 768/1024/1536/2048/3072 dims (all-MiniLM-L6-v2 is 384-d: unsupported).

# ── A2A (Agent-to-Agent) protocol ───────────────────────────────────────────
# A2A_TENANT_ID=            # REQUIRED for the /a2a/tasks endpoint to work
# A2A_SHARED_SECRET=        # HMAC-SHA256 signing secret; empty = auth disabled (dev only)

# ── Slack integration ────────────────────────────────────────────────────────
# SLACK_TENANT_ID is no longer used: Slack commands/actions go to the tenant
# bound to the signature-verified workspace (Channels / Gateway bindings).
# SLACK_SIGNING_SECRET=      # platform Slack app; a tenant's own app signs with its binding secret
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APPROVAL_CHANNEL=hitl-approvals

# ── Inbound channel webhooks (/channels/*) — fail closed when unset ─────────
# Slack uses SLACK_SIGNING_SECRET; Teams uses TEAMS_APP_ID (Bot Framework JWT);
# Discord uses DISCORD_PUBLIC_KEY (Ed25519). Relay channels need an operator
# secret, sent as X-Webhook-Secret or as the HTTP Basic password in the URL.
# CHANNEL_WEBHOOK_SECRET_EMAIL=
# CHANNEL_WEBHOOK_SECRET_SMS=
# CHANNEL_WEBHOOK_SECRET_VOICE=
# CHANNEL_WEBHOOK_SECRET_FORM=
# CHANNEL_WEBHOOK_SECRET_MEETING=

# ── Messaging gateway bindings (/v1/gateway/{channel}/chat) ──────────────────
# Tenants bind their own Telegram bots, WhatsApp numbers, Slack workspaces,
# Teams orgs and generic webhooks (POST /channels/bindings, Settings > Gateway);
# secrets are sealed with the tenant envelope key.
# GATEWAY_PUBLIC_BASE_URL=https://agents.example.com   # https only; lets the server
#                           # setWebhook Telegram bindings and print absolute URLs
# CHANNEL_TENANT_MAP=       # DEPRECATED operator fallback (per-process, plain-env
#                           # secrets): channel:addressee:tenant[:org[:secret]][;outbound_token=T]
#                           # used only for addressees no tenant has bound; warns at startup

# ── Zapier integration ───────────────────────────────────────────────────────
# ZAPIER_TENANT_ID=         # tenant_id for goals triggered via Zapier
# ZAPIER_WEBHOOK_SECRET=

# ── IMAP email-to-goal listener ─────────────────────────────────────────────
IMAP_ENABLED=false
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=goals@example.com
# IMAP_PASSWORD=
# IMAP_SSL=true
# IMAP_MAILBOX=INBOX
# IMAP_TENANT_ID=
# Required: only these senders (addresses or @domains) may create goals, and only
# with a DKIM/SPF/DMARC pass in the receiving MTA's Authentication-Results.
# IMAP_SENDER_ALLOWLIST=@example.com,ops@partner.example
# IMAP_AUTHSERV_ID=mx.example.com

# ── SMTP outbound email (MailPit for local dev) ──────────────────────────────
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASSWORD=
SMTP_TLS=false

# ── Runtime tuning ───────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=90
AGENTVERSE_DB_SCHEDULE_DISCOVERY=true
EMBEDDING_DIM=1536

# ── MCP Built-in Servers ─────────────────────────────────────────────────────
# GITHUB_TOKEN=
# POSTGRES_MCP_URL=
POSTGRES_MCP_ALLOW_WRITES=false

# ── Shell execution (disabled by default for security) ───────────────────────
AGENTVERSE_ALLOW_SHELL_EXEC=false
AGENTVERSE_ALLOW_SUBPROCESS_EXEC=false

# ── SearXNG ──────────────────────────────────────────────────────────────────
SEARXNG_URL=http://searxng:8080

# ── Production model routing ─────────────────────────────────────────────────
DEFAULT_LLM_PROVIDER=anthropic

# ── Voice OS (native STT/TTS — Task 12.1) ─────────────────────────────────────
VOICE_ENABLED=true
VOICE_DEVICE=cpu                         # cpu | cuda
VOICE_STT_PROVIDER=faster_whisper        # faster_whisper | whisper_api | assemblyai
VOICE_TTS_PROVIDER=kokoro               # kokoro | omnivoice | elevenlabs | openai_tts | azure_tts
VOICE_STT_MODEL=tiny                     # small & offline-friendly for local dev; use large-v3-turbo in production
VOICE_TTS_MODEL=k2-fsa/OmniVoice
# MODEL_CACHE_DIR=/app/models            # Docker only — leave unset locally to use ~/.cache/agentverse/models
VOICE_MAX_AUDIO_MB=25
VOICE_GREETING_CACHE_TTL=300

# Optional: voice persona S3 storage (for voice cloning per org)
VOICE_PERSONA_BUCKET=agentverse-voice-personas
# S3_ENDPOINT_URL=http://minio:9000
# S3_ACCESS_KEY=minioadmin
# S3_SECRET_KEY=minioadmin

# Optional: paid TTS API keys (unused when VOICE_TTS_PROVIDER=kokoro/omnivoice)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=rachel
# OPENAI_TTS_VOICE=nova
# AZURE_TTS_KEY=
# AZURE_TTS_REGION=eastus

# Optional: paid STT API keys (unused when VOICE_STT_PROVIDER=faster_whisper)
# ASSEMBLY_AI_KEY=

# Optional: agent runtime trade-off switches (defaults = shipped behaviour)
# Errored guardrail engine fails closed on EVERY step, not only high-risk ones.
# GUARDRAIL_FAIL_CLOSED_ALL=false
# Risk class of interactive RPA tools (rpa_click/rpa_type/...): write_low | write_high
# RPA_INTERACTION_RISK=write_low
# How often a model with no capability data probes richer execution modes (0..1).
# EXPLORE_RATE_UNKNOWN=1.0

# Optional: owner decisions (defaults = shipped behaviour)
# Shortest gap (seconds) a plan may schedule between fires; beat ticks every 60 s.
# SCHEDULE_MIN_INTERVAL_FREE_S=900
# SCHEDULE_MIN_INTERVAL_STARTER_S=300
# SCHEDULE_MIN_INTERVAL_PROFESSIONAL_S=60
# SCHEDULE_MIN_INTERVAL_ENTERPRISE_S=60
# Repository ingestions one tenant may have queued or running at once.
# REPO_INGEST_MAX_CONCURRENT_PER_TENANT=2
# Collections one federated knowledge search may fan out to.
# KNOWLEDGE_FEDERATED_MAX_COLLECTIONS=20
# Pin connector drivers to egress-checked addresses; drivers that cannot be pinned
# (confluent-kafka / librdkafka) are refused while true.
# INGESTION_EGRESS_STRICT_PINNING=true
# Upstream-deletion reconciliation (object-store Sources: S3/MinIO, GCS, Azure Blob):
# documents deleted upstream are removed by the ingestion.reconcile_source task,
# which a failure-free sync queues at most once per this many seconds per Source
# (min 300; needs the shared Redis). POST /sources/{id}/reconcile runs it on demand.
# INGESTION_RECONCILE_INTERVAL_SECONDS=86400
# Connector egress escape hatch (OPERATOR-ONLY, default off). Connectors refuse private,
# loopback, link-local and cloud-metadata addresses. To let them reach your OWN internal
# infrastructure (e.g. a MinIO on 192.168.63.104), turn the flag on AND list each host:
# hostnames and IP literals are both accepted, comma-separated. The allowlist alone does
# nothing without the flag, and only the listed hosts open up — every other private /
# metadata / neighbouring address stays blocked. These are env-only: a tenant's
# connection_config can never set or widen them. Set the same values on the API and every
# worker / beat (helm: ingestion.*, k8s: agentverse-config, prod compose: shared env).
# A host entry covers every port of that host. TESTING ONLY: whole private ranges may be
# listed in CIDR form (192.168.0.0/16, 172.16.0.0/12, 10.0.0.0/8, fc00::/7, ...); the cloud
# metadata service, link-local 169.254.0.0/16 and 0.0.0.0/8 stay blocked even when listed,
# and a hostname is allowed only if EVERY address it resolves to is public or inside a
# listed range. ENVIRONMENT=production refuses CIDR entries at startup — name the
# services (mongo.db.svc, minio.storage.svc) there instead.
# INGESTION_ALLOW_INTERNAL_SOURCES=false
# INGESTION_INTERNAL_SOURCE_ALLOWLIST=192.168.63.104,minio.internal
# INGESTION_INTERNAL_SOURCE_ALLOWLIST=192.168.0.0/16,172.16.0.0/12,10.0.0.0/8   # testing only
# Private network access (default true, EVERY environment incl. production):
# ingestion sources, connectors (MongoDB, Postgres, Kafka, MCP, OAuth token
# URLs …) and model endpoints (tenant LLM base_url, hosted reranker, fine-tune)
# may reach private / internal hosts and IPs. Cloud metadata, link-local and
# 0.0.0.0 stay blocked.
# WARNING: with this on, any TENANT-supplied URL in those places (a connector
# URL, an MCP server, a BYOK LLM base_url) can reach this cluster's internal
# network. On a multi-tenant deployment with untrusted tenants set it to false
# and use INGESTION_INTERNAL_SOURCE_ALLOWLIST / TENANT_LLM_ALLOWED_PRIVATE_HOSTS.
# ALLOW_PRIVATE_NETWORK_ACCESS=true
# OCR parallelism (one bounded pool per process, shared by every document: API
# uploads, /ocr, ZIP members, ingestion jobs). Pages of a document are OCR'd
# concurrently, rendered one at a time; set the same values on the API and every
# worker (helm: ocr.*, k8s: agentverse-config, prod compose: shared env).
# OCR threads AND page bitmaps in flight per process; 0 = the CPUs this process
# may use (container CPU quota aware; split between a prefork worker's children).
# OCR_MAX_CONCURRENCY=0
# Pages of ONE document at once; 0 = OCR_MAX_CONCURRENCY - 1 (min 2), so another
# document always progresses beside a huge scan. Never above OCR_MAX_CONCURRENCY.
# OCR_PAGE_CONCURRENCY=0
# LLM-vision fallback calls (low-confidence pages) in flight per process.
# OCR_VISION_CONCURRENCY=4
# Resolution scanned PDF pages are rasterised at.
# OCR_RENDER_DPI=300
# Documents ONE connector sync ingests at once (fetch, parse / OCR, embed, index);
# the cursor still advances in source order, only past finished documents.
# 1 = one document at a time. Set the same value on the API and every worker.
# INGESTION_SYNC_DOC_CONCURRENCY=4
# Tesseract on/off (default false). false = skip Tesseract: every page is read by
# the LLM-vision OCR model (Model Registry OCR order, with failover). true =
# Tesseract first, LLM vision only for low-confidence pages.
# OCR_TESSERACT_ENABLED=false
# Per-model timeout for vision / OCR calls (default: AGENTVERSE_LLM_CALL_TIMEOUT_SECONDS,
# 60s). Hosted large vision models can take minutes (NVIDIA Llama 3.2 90B Vision
# ~200s); raise this to keep one, or let the next model in the order take over.
# AGENTVERSE_VISION_CALL_TIMEOUT_SECONDS=60
# Tesseract's own OpenMP threads per process (the image sets 1: pages run in parallel).
# OMP_THREAD_LIMIT=1
# Fully-autonomous agents need an attached eval suite whose latest run passes the gate.
# FULLY_AUTONOMOUS_EVAL_GATE_ENABLED=true
# Supervisor sub-goals run under the parent's concurrent-goal slot (false = own slot).
# SUBGOALS_SHARE_PARENT_SLOT=true

# BYOK-only deployments: set to false so production starts without a platform LLM key.
# Tenants with their own key (Settings -> LLM Providers) run; others get "no LLM provider configured".
LLM_REQUIRE_PLATFORM_KEY=true

# ── Model Registry operators ──────────────────────────────────────────────────
# Tenants whose ADMIN users may change the deployment-wide model registry (add
# models, import the catalog, set the per-capability preference order) without
# the platform admin key. Comma-separated tenant ids; "*" = any tenant's admins.
# Unset: any tenant admin outside production; production accepts only the
# platform admin key (PLATFORM_ADMIN_KEY via X-Admin-Key) until this is set.
# PLATFORM_ADMIN_TENANT_IDS=
