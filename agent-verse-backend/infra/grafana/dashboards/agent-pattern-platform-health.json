{
  "uid": "agent-pattern-platform-health",
  "title": "Agent Pattern Platform Health",
  "schemaVersion": 39,
  "refresh": "30s",
  "panels": [
    {"id": 1, "title": "Coordination delivery lag", "type": "timeseries", "targets": [{"expr": "agentverse_coordination_outbox_lag_seconds"}]},
    {"id": 2, "title": "Strategy p95 latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.95, sum by (le,family) (rate(agentverse_strategy_duration_seconds_bucket[5m])))"}]},
    {"id": 3, "title": "Strategy p99 latency", "type": "timeseries", "targets": [{"expr": "histogram_quantile(0.99, sum by (le,family) (rate(agentverse_strategy_duration_seconds_bucket[5m])))"}]},
    {"id": 4, "title": "Active leases", "type": "stat", "targets": [{"expr": "sum(agentverse_coordination_active_leases)"}]},
    {"id": 5, "title": "Fallback rate", "type": "timeseries", "targets": [{"expr": "sum(rate(agentverse_coordination_event_total{event=\"fallback\"}[5m]))"}]},
    {"id": 6, "title": "Sandbox denials", "type": "timeseries", "targets": [{"expr": "sum(rate(agentverse_pattern_safety_total{kind=\"sandbox\",status=\"denied\"}[5m]))"}]}
  ]
}
