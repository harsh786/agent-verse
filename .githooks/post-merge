#!/usr/bin/env bash
# post-merge hook — runs after `git merge` or `git pull`
# Auto-syncs dependencies and runs migrations when deps/migrations change.

set -euo pipefail

YELLOW='\033[1;33m'; GREEN='\033[0;32m'; NC='\033[0m'

CHANGED=$(git diff HEAD@{1} HEAD --name-only 2>/dev/null || true)

# ─── 1. Backend: sync deps if pyproject.toml or uv.lock changed ──────────────
if echo "$CHANGED" | grep -qE 'agent-verse-backend/(pyproject\.toml|uv\.lock)'; then
  echo -e "${YELLOW}📦 Backend dependencies changed — running uv sync...${NC}"
  cd agent-verse-backend && uv sync && cd ..
  echo -e "${GREEN}✅ Backend deps synced${NC}"
fi

# ─── 2. Backend: remind about migrations if new ones added ───────────────────
NEW_MIGRATIONS=$(echo "$CHANGED" | grep -E 'agent-verse-backend/app/db/migrations/versions/' || true)
if [ -n "$NEW_MIGRATIONS" ]; then
  echo -e "${YELLOW}🗄️  New migration(s) detected:${NC}"
  echo "$NEW_MIGRATIONS"
  echo -e "${YELLOW}Run: cd agent-verse-backend && uv run alembic upgrade head${NC}"
fi

# ─── 3. Frontend: sync deps if package.json or package-lock.json changed ─────
if echo "$CHANGED" | grep -qE 'agent-verse-frontend/(package\.json|package-lock\.json)'; then
  echo -e "${YELLOW}📦 Frontend dependencies changed — running npm ci...${NC}"
  cd agent-verse-frontend && npm ci && cd ..
  echo -e "${GREEN}✅ Frontend deps synced${NC}"
fi

# ─── 4. Remind if .github/instructions changed ───────────────────────────────
if echo "$CHANGED" | grep -qE '\.github/(instructions|prompts|agents|copilot-instructions)'; then
  echo -e "${YELLOW}ℹ️  Copilot instructions updated — reload VS Code to pick up changes${NC}"
fi
