#!/usr/bin/env bash
# pre-commit hook — runs fast checks before every commit
# Blocks commit if any check fails.
# Install: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

echo -e "${YELLOW}🔍 AgentVerse pre-commit checks...${NC}"

# Detect which files changed
BACKEND_CHANGED=$(git diff --cached --name-only | grep -E '^agent-verse-backend/.*\.py$' || true)
FRONTEND_CHANGED=$(git diff --cached --name-only | grep -E '^agent-verse-frontend/src/.*\.(ts|tsx)$' || true)
MIGRATION_CHANGED=$(git diff --cached --name-only | grep -E '^agent-verse-backend/app/db/migrations/' || true)
WORKFLOW_CHANGED=$(git diff --cached --name-only | grep -E '^\.github/workflows/' || true)

# ─── 1. Secret scanning (ALWAYS — never commit secrets) ───────────────────────
echo -e "  🔐 Scanning for secrets..."
if git diff --cached | grep -E '(api_key|secret|password|token|credential)\s*=\s*["\x27][a-zA-Z0-9_\-]{20,}' 2>/dev/null | grep -v 'settings\.\|test_\|fake_\|placeholder'; then
  echo -e "${RED}❌ Possible secret detected in diff. Use settings.* or env vars.${NC}"
  exit 1
fi
echo -e "  ${GREEN}✅ No secrets found${NC}"

# ─── 2. Backend checks (only when .py files staged) ──────────────────────────
if [ -n "$BACKEND_CHANGED" ]; then
  echo -e "  🐍 Backend: ruff lint..."
  cd agent-verse-backend

  # Fast lint on changed files only
  CHANGED_FILES=$(echo "$BACKEND_CHANGED" | sed 's|agent-verse-backend/||g' | tr '\n' ' ')
  if ! uv run ruff check $CHANGED_FILES 2>&1; then
    echo -e "${RED}❌ ruff failed. Run: cd agent-verse-backend && uv run ruff check --fix${NC}"
    cd ..
    exit 1
  fi
  echo -e "  ${GREEN}✅ ruff passed${NC}"

  # Type check changed modules only (fast subset)
  echo -e "  🔷 Backend: mypy (changed modules)..."
  MODULES=$(echo "$BACKEND_CHANGED" | sed 's|agent-verse-backend/||g' | xargs -I{} dirname {} | sort -u | grep '^app/' | head -5 | tr '\n' ' ')
  if [ -n "$MODULES" ] && ! uv run mypy $MODULES --no-error-summary 2>&1 | grep -v '^Success'; then
    echo -e "${RED}❌ mypy failed. Fix type errors before committing.${NC}"
    cd ..
    exit 1
  fi
  echo -e "  ${GREEN}✅ mypy passed${NC}"
  cd ..
fi

# ─── 3. Migration safety check ────────────────────────────────────────────────
if [ -n "$MIGRATION_CHANGED" ]; then
  echo -e "  🗄️  Migration safety check..."
  cd agent-verse-backend

  for f in $MIGRATION_CHANGED; do
    FILENAME=$(echo "$f" | sed 's|agent-verse-backend/||g')
    # Warn if CREATE INDEX without CONCURRENTLY (table lock risk)
    if grep -q 'op.create_index' "$FILENAME" 2>/dev/null; then
      echo -e "${YELLOW}⚠️  $f: Use CREATE INDEX CONCURRENTLY for production safety${NC}"
      echo -e "    Replace op.create_index() with:"
      echo -e '    op.execute("CREATE INDEX CONCURRENTLY IF NOT EXISTS idx_... ON ...")'
    fi
    # Warn if NOT NULL added without default (blocks table)
    if grep -qE 'nullable=False' "$FILENAME" && ! grep -qE 'server_default|default=' "$FILENAME" 2>/dev/null; then
      echo -e "${YELLOW}⚠️  $f: Adding NOT NULL column may require a default value for zero-downtime${NC}"
    fi
  done
  cd ..
  echo -e "  ${GREEN}✅ Migration check done${NC}"
fi

# ─── 4. Frontend checks (only when .ts/.tsx files staged) ────────────────────
if [ -n "$FRONTEND_CHANGED" ]; then
  echo -e "  ⚛️  Frontend: TypeScript check..."
  cd agent-verse-frontend

  if ! npm run typecheck -- --noEmit 2>&1 | tail -5; then
    echo -e "${RED}❌ TypeScript errors found. Fix before committing.${NC}"
    cd ..
    exit 1
  fi
  echo -e "  ${GREEN}✅ TypeScript passed${NC}"

  echo -e "  🧹 Frontend: ESLint..."
  CHANGED_FE=$(echo "$FRONTEND_CHANGED" | sed 's|agent-verse-frontend/||g' | tr '\n' ' ')
  if ! npx eslint $CHANGED_FE --max-warnings 0 2>&1 | tail -5; then
    echo -e "${RED}❌ ESLint errors found. Fix before committing.${NC}"
    cd ..
    exit 1
  fi
  echo -e "  ${GREEN}✅ ESLint passed${NC}"
  cd ..
fi

# ─── 5. GitHub workflow YAML validation ───────────────────────────────────────
if [ -n "$WORKFLOW_CHANGED" ] && command -v actionlint >/dev/null 2>&1; then
  echo -e "  🔄 GitHub Actions: actionlint..."
  if ! actionlint $WORKFLOW_CHANGED 2>&1; then
    echo -e "${YELLOW}⚠️  actionlint found issues in workflow files${NC}"
  fi
fi

# ─── 6. No debug statements left in code ─────────────────────────────────────
echo -e "  🐛 Checking for debug statements..."
if git diff --cached | grep -E '^\+.*(print\(|debugger;|console\.log\(|pdb\.set_trace|breakpoint\()' | grep -v '^\+\+\+' | grep -v '#.*print\|# debug\|# noqa'; then
  echo -e "${YELLOW}⚠️  Debug statements found. Remove before committing.${NC}"
  # Warn only — don't block (test files may have print)
fi

echo -e "${GREEN}✅ All pre-commit checks passed!${NC}"
