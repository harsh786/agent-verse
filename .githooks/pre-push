#!/usr/bin/env bash
# pre-push hook — runs full test suite before pushing to remote
# Blocks push if tests fail.
# Install: git config core.hooksPath .githooks

set -euo pipefail

RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'; NC='\033[0m'

REMOTE=$1
URL=$2

# Capture repo root once — use this throughout the script
REPO_ROOT="$(cd "$(dirname "$0")/.." && pwd)"

echo -e "${YELLOW}🚀 AgentVerse pre-push checks (remote: $REMOTE)...${NC}"

# Skip tests when pushing to personal/feature branches (only block main/release)
CURRENT_BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [[ "$CURRENT_BRANCH" != "main" && "$CURRENT_BRANCH" != "release/"* ]]; then
  echo -e "${YELLOW}ℹ️  Branch '$CURRENT_BRANCH' — running quick checks only (full suite on PR)${NC}"
  RUN_FULL_SUITE=false
else
  RUN_FULL_SUITE=true
fi

# ─── 1. Backend: unit tests (always run — fast, no Docker needed) ─────────────
echo -e "  🐍 Backend: unit tests..."
  cd "$REPO_ROOT/agent-verse-backend"
if [ ! -d "$REPO_ROOT/agent-verse-sdk-python" ]; then
  echo -e "  ${YELLOW}⚠️  agent-verse-sdk-python not found — skipping backend tests (CI will run them)${NC}"
  echo -e "  ${YELLOW}   To run locally: cd agent-verse-sdk-python && pip install -e . first${NC}"
  cd ..
else
  if ! uv run pytest tests/ -m "not integration and not slow" \
    --timeout=60 \
    --tb=short \
    -q 2>&1 | tail -15; then
    echo -e "${RED}❌ Backend unit tests failed. Fix before pushing.${NC}"
    cd ..
    exit 1
  fi
  echo -e "  ${GREEN}✅ Backend unit tests passed${NC}"
fi

# ─── 2. Backend: ruff + mypy (only when SDK available) ────────────────────────
if [ -d "$REPO_ROOT/agent-verse-sdk-python" ]; then
  echo -e "  🔷 Backend: ruff + mypy (full)..."
  if ! uv run ruff check app/ 2>&1 | tail -5; then
    echo -e "${RED}❌ ruff failed. Run: uv run ruff check --fix app/${NC}"
    cd ..
    exit 1
  fi
  if ! uv run mypy app/ --no-error-summary 2>&1 | tail -5; then
    echo -e "${RED}❌ mypy failed.${NC}"
    cd ..
    exit 1
  fi
  echo -e "  ${GREEN}✅ ruff + mypy passed${NC}"
else
  echo -e "  ${YELLOW}⚠️  Skipping ruff/mypy (SDK not available) — run: uv run ruff check app/${NC}"
fi
cd "$REPO_ROOT"

# ─── 3. Frontend: typecheck + lint + unit tests ───────────────────────────────
echo -e "  ⚛️  Frontend: typecheck + lint + unit tests..."
cd "$REPO_ROOT/agent-verse-frontend"

if ! npm run typecheck 2>&1 | tail -5; then
  echo -e "${RED}❌ TypeScript errors. Fix before pushing.${NC}"
  cd "$REPO_ROOT"
  exit 1
fi

if ! npm run lint 2>&1 | tail -5; then
  echo -e "${RED}❌ ESLint errors. Fix before pushing.${NC}"
  cd "$REPO_ROOT"
  exit 1
fi

# Run tests with retry (1 retry for flaky tests) and a pool size limit
# The full suite runs in CI — pre-push runs the quick subset
if ! npx vitest run \
    --pool=forks \
    --poolOptions.forks.singleFork=true \
    --reporter=verbose 2>&1 | tail -10; then
  echo -e "${YELLOW}⚠️  Tests failed on first run, retrying once...${NC}"
  if ! npx vitest run \
      --pool=forks \
      --poolOptions.forks.singleFork=true \
      --reporter=verbose 2>&1 | tail -10; then
    echo -e "${RED}❌ Frontend tests failed after retry. Fix before pushing.${NC}"
    cd "$REPO_ROOT"
    exit 1
  fi
fi
echo -e "  ${GREEN}✅ Frontend checks passed${NC}"
cd ..

# ─── 4. Integration tests (only on main/release AND when Docker+SDK available) ──
if [ "$RUN_FULL_SUITE" = true ]; then
  if [ ! -d "$REPO_ROOT/agent-verse-sdk-python" ]; then
    echo -e "  ${YELLOW}⚠️  Skipping integration tests (SDK not available) — CI runs them${NC}"
  elif ! command -v docker &>/dev/null; then
    echo -e "  ${YELLOW}⚠️  Skipping integration tests (Docker not available)${NC}"
  else
    echo -e "  🐳 Running integration tests (pushing to $CURRENT_BRANCH)..."
    cd "$REPO_ROOT/agent-verse-backend"
    if ! DOCKER_HOST="unix:///Users/$USER/.colima/default/docker.sock" \
        TESTCONTAINERS_RYUK_DISABLED=true \
        uv run pytest tests/ -m "integration" \
        --timeout=120 --tb=short -q 2>&1 | tail -20; then
      echo -e "${RED}❌ Integration tests failed.${NC}"
      cd "$REPO_ROOT"
      exit 1
    fi
    echo -e "  ${GREEN}✅ Integration tests passed${NC}"
    cd "$REPO_ROOT"
  fi
fi

echo -e "${GREEN}✅ All pre-push checks passed! Pushing to $REMOTE...${NC}"
