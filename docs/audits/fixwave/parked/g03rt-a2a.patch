+                    "ON g.id = t.goal_id AND g.tenant_id = t.tenant_id "
+                    "WHERE t.status IN ('accepted', 'working') "
+                    "ORDER BY t.updated_at LIMIT :n"
+                ),
+                {"n": batch},
+            )
+        ).fetchall()
+    finalized = expired = 0
+    for task_id, tenant_id, goal_id, goal_status, goal_error, age in rows:
+        if goal_id is None or goal_status is None:
+            if float(age or 0) > unstarted_after_s:
+                reason = "goal was never started" if goal_id is None else "goal no longer exists"
+                if await finalize_and_notify(task_id, tenant_id, "failed", reason, tenant_db):
+                    expired += 1
+            continue
+        mapped = _GOAL_TERMINAL_TO_A2A.get(str(goal_status).lower())
+        if mapped is None:
+            continue  # still running (or waiting on a human): leave it open
+        if mapped == "complete":
+            result = await _reconciled_result(tenant_db, goal_id, tenant_id, str(goal_status))
+        else:
+            result = str(goal_error or f"Goal {goal_id} {goal_status}")
+        if await finalize_and_notify(task_id, tenant_id, mapped, result, tenant_db):
+            finalized += 1
+    return {"open": len(rows), "finalized": finalized, "expired": expired}
