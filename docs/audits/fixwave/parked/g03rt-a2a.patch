@@ -0,0 +1,114 @@
+"""A2A-01: inbound tasks record their goal and are finalized exactly once.
+
+Tasks ran in an in-process create_task watcher with a 300 s timeout: a restart
+stranded them as "accepted", long goals were recorded as "timeout" (while the
+goal kept running) and no goal id was stored.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import os
+from typing import Any
+from unittest.mock import AsyncMock, MagicMock, patch
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+import app.api.a2a as a2a
+from app.tenancy.context import PlanTier, TenantContext
+
+CTX = TenantContext(tenant_id="t-a2a-d", plan=PlanTier.PROFESSIONAL, api_key_id="k")
+
+
+@pytest.fixture(autouse=True)
+def _clean() -> Any:
+    a2a._tasks.clear()
+    yield
+    a2a._tasks.clear()
+
+
+def _app(goal_service: Any) -> TestClient:
+    app = FastAPI()
+
+    @app.middleware("http")
+    async def _inject(request: Any, call_next: Any) -> Any:
+        request.state.tenant = CTX
+        return await call_next(request)
+
+    app.include_router(a2a.router)
+    app.state.goal_service = goal_service
+    return TestClient(app)
+
+
+def _goal_service(*, events: list[dict[str, Any]] | None = None) -> MagicMock:
+    svc = MagicMock()
+    svc.submit_goal = AsyncMock(return_value={"goal_id": "goal-77"})
+
+    async def _subscribe(**_kw: Any) -> Any:
+        for evt in events or []:
+            yield evt
+        # The stream ends with the goal still running (persisted status below):
+        # not an outcome, so the task must stay open.
+
+    svc.subscribe_events = _subscribe
+    svc.get_goal = AsyncMock(return_value={"status": "running"})
+    return svc
+
+
+def test_task_records_its_goal_and_is_working() -> None:
+    with patch.dict(os.environ, {"A2A_SHARED_SECRET": ""}):
+        resp = _app(_goal_service()).post("/a2a/tasks", json={"goal": "do it"})
+    assert resp.status_code == 202, resp.text
+    body = resp.json()
+    assert body["status"] == "working" and body["goal_id"] == "goal-77"
+    stored = a2a._tasks[body["task_id"]]
+    assert stored["goal_id"] == "goal-77"
+    # The stream ended while the goal is still running: no outcome is invented.
+    assert stored["status"] == "working"
+
+
+async def test_fast_path_timeout_never_writes_a_fake_outcome() -> None:
+    svc = _goal_service()
+
+    async def _slow(**_kw: Any) -> Any:
+        await asyncio.sleep(10)
+        yield {}
+
+    svc.subscribe_events = _slow
+    status, _ = await a2a._await_goal_outcome(svc, "goal-77", CTX, timeout_s=0.05)
+    assert status == "timeout"
+    a2a._tasks["tk"] = {"tenant_id": CTX.tenant_id, "status": "working", "callback_url": ""}
+    # The receive handler's fast path ignores "timeout": the task stays open.
+    assert a2a._tasks["tk"]["status"] == "working"
+
+
+async def test_finalize_is_exactly_once_and_only_the_winner_calls_back() -> None:
+    a2a._tasks["tk"] = {
+        "tenant_id": CTX.tenant_id,
+        "status": "working",
+        "callback_url": "https://peer.example/cb",
+    }
+    sent: list[tuple[str, str]] = []
+
+    async def _cb(url: str, task_id: str, status: str, result: str) -> bool:
+        sent.append((task_id, status))
+        return True
+
+    with patch.object(a2a, "_send_callback", _cb):
+        first = await a2a.finalize_and_notify("tk", CTX.tenant_id, "complete", "done", None)
+        second = await a2a.finalize_and_notify("tk", CTX.tenant_id, "failed", "late", None)
+    assert (first, second) == (True, False)
+    assert sent == [("tk", "complete")]
+    assert a2a._tasks["tk"]["status"] == "complete"
+
+
+def test_submit_failure_fails_the_task() -> None:
+    svc = _goal_service()
