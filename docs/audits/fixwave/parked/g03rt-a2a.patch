diff --git a/agent-verse-backend/tests/integration/test_a2a_reconcile_pg.py b/agent-verse-backend/tests/integration/test_a2a_reconcile_pg.py
new file mode 100644
index 000000000..187bc10a9
--- /dev/null
+++ b/agent-verse-backend/tests/integration/test_a2a_reconcile_pg.py
@@ -0,0 +1,98 @@
+"""A2A-01 against real Postgres: after a restart (no in-process watcher), the
+reconciliation beat finalizes open tasks from their goals' persisted status,
+exactly once, with the callback; a goal that outlives any watcher still ends
+"complete"; a task whose goal was never recorded is failed."""
+
+from __future__ import annotations
+
+import uuid
+from typing import Any
+from unittest.mock import patch
+
+import pytest
+
+pytestmark = pytest.mark.integration
+
+
+async def test_reconcile_finalizes_from_goal_status(pg_url: str) -> None:
+    from sqlalchemy import text
+    from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine
+    from sqlalchemy.pool import NullPool
+
+    import app.api.a2a as a2a
+
+    engine = create_async_engine(pg_url, poolclass=NullPool)
+    factory = async_sessionmaker(engine, expire_on_commit=False)
+    tenant = uuid.uuid4().hex[:16]
+    g_done, g_failed, g_running = (uuid.uuid4().hex for _ in range(3))
+    try:
+        async with factory() as s, s.begin():
+            await s.execute(
+                text(
+                    "INSERT INTO tenants (id, name, email, plan_tier) "
+                    "VALUES (:id, 'A2A', :email, 'professional')"
+                ),
+                {"id": tenant, "email": f"{tenant}@example.com"},
+            )
+            for gid, status, err in (
+                (g_done, "complete", None),
+                (g_failed, "failed", "tool exploded"),
+                (g_running, "executing", None),
+            ):
+                await s.execute(
+                    text(
+                        "INSERT INTO goals (id, tenant_id, goal_text, status, error_message) "
+                        "VALUES (:id, :t, 'g', :st, :err)"
+                    ),
+                    {"id": gid, "t": tenant, "st": status, "err": err},
+                )
+            for tid, gid, age in (
+                ("t-done", g_done, 0),
+                ("t-failed", g_failed, 0),
+                ("t-running", g_running, 0),
+                ("t-lost", None, 3600),  # API died between accept and submit
+            ):
+                await s.execute(
+                    text(
+                        "INSERT INTO a2a_tasks (id, tenant_id, goal_text, status, callback_url, "
+                        "goal_id, created_at, updated_at) VALUES (:id, :t, 'g', "
+                        "CASE WHEN :gid IS NULL THEN 'accepted' ELSE 'working' END, "
+                        "'https://peer.example/cb', :gid, NOW(), "
+                        "NOW() - make_interval(secs => :age))"
+                    ),
+                    {"id": f"{tenant}-{tid}", "t": tenant, "gid": gid, "age": age},
+                )
+
+        sent: list[tuple[str, str]] = []
+
+        async def _cb(url: str, task_id: str, status: str, result: str) -> bool:
+            sent.append((task_id.split("-", 1)[1], status))
+            return True
+
+        with patch.object(a2a, "_send_callback", _cb):
+            first = await a2a.reconcile_open_tasks(factory, factory)
+            second = await a2a.reconcile_open_tasks(factory, factory)
+
+        assert first["finalized"] == 2 and first["expired"] == 1
+        assert second["finalized"] == 0 and second["expired"] == 0
+        assert sorted(sent) == [
+            ("t-done", "complete"),
+            ("t-failed", "failed"),
+            ("t-lost", "failed"),
+        ]
+        async with factory() as s:
+            rows: dict[str, Any] = {
+                r[0].split("-", 1)[1]: (r[1], r[2])
+                for r in (
+                    await s.execute(
+                        text("SELECT id, status, result FROM a2a_tasks WHERE tenant_id = :t"),
+                        {"t": tenant},
+                    )
+                ).fetchall()
+            }
+        assert rows["t-done"][0] == "complete"
+        assert rows["t-failed"] == ("failed", "tool exploded")
+        assert rows["t-running"][0] == "working"
+        assert rows["t-lost"][0] == "failed"
+    finally:
+        await engine.dispose()
