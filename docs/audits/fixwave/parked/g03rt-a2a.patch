+async def reconcile_open_tasks(
+    system_db: Any,
+    tenant_db: Any,
+    *,
+    unstarted_after_s: float = 600.0,
+    batch: int = 500,
+) -> dict[str, int]:
+    """Finalize open A2A tasks whose goal reached a terminal state.
+
+    Reads open tasks with their goal's persisted status across tenants (system
+    session), then finalizes each under its tenant's RLS context (exactly once,
+    with the signed callback). A task whose goal was never recorded (the API
+    died between accepting and submitting) or no longer exists is failed after
+    ``unstarted_after_s``.
