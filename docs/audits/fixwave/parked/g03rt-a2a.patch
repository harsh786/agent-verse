+"""Celery beat task reconciling open inbound A2A tasks with their goals (A2A-01).
+
+Inbound A2A tasks record the goal that runs them; this beat (``reconcile-a2a-
+tasks``, celery_app.py) finalizes every open task whose goal reached a terminal
+state and sends its signed callback, so a restart, deploy or a goal that runs
+for hours never strands a task as "accepted".
+"""
+
+from __future__ import annotations
+
+from typing import Any, cast
+
+from app.scaling.beat_guard import beat_task_guard
+from app.scaling.celery_app import celery_app
+
+
+async def _reconcile_once() -> dict[str, int]:
+    from app.api.a2a import reconcile_open_tasks
+    from app.db.session import get_session_factory, get_system_session_factory
+
+    return await reconcile_open_tasks(get_system_session_factory(), get_session_factory())
+
+
+@celery_app.task(
+    name="app.scaling.a2a_tasks.reconcile_a2a_tasks",
+    bind=True,
+    max_retries=0,
+    queue="maintenance",
+)
+@beat_task_guard(lock_ttl_seconds=120)
+def reconcile_a2a_tasks(self: Any) -> dict[str, Any]:
+    from app.scaling.tasks import _run_async
+
+    return cast(dict[str, Any], _run_async(_reconcile_once()))
+
+
+__all__ = ["reconcile_a2a_tasks"]
