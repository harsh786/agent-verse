+    with patch.dict(os.environ, {"A2A_SHARED_SECRET": ""}):
+        resp = _app(svc).post("/a2a/tasks", json={"goal": "do it"})
+    assert resp.status_code == 502
+    [task] = a2a._tasks.values()
+    assert task["status"] == "failed"
