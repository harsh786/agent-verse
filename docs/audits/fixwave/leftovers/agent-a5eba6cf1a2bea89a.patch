new file mode 100644
index 000000000..236f874e7
--- /dev/null
+++ b/agent-verse-backend/tests/services/test_sse_resume_cursor.py
@@ -0,0 +1,161 @@
+"""SVC-05: SSE resume must not drift or lose events.
+
+* live and fully-replayed events carried no ``_seq``, so the SSE id fell back
+  to a per-connection counter and Last-Event-ID drifted;
+* resume replay was capped at 100 events with no paging;
+* the cross-replica path replayed BEFORE subscribing (events in between were
+  lost) and yielded the raw worker envelope.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+from datetime import UTC, datetime
+from typing import Any
+from unittest.mock import AsyncMock
+
+import fakeredis
+import fakeredis.aioredis
+import pytest
+
+from app.services.goal_service import GoalRecord, GoalService, GoalStatus
+from app.tenancy.context import PlanTier, TenantContext
+
+CTX = TenantContext(tenant_id="t-seq", plan=PlanTier.FREE, api_key_id="k")
+
+
+class _Store:
+    """Event store fake: sequences, keyset paging, honours ``limit``."""
+
+    def __init__(self, n: int = 0) -> None:
+        self.events: list[dict[str, Any]] = [{"type": "step", "i": i} for i in range(1, n + 1)]
+        self.on_list: Any = None
+
+    async def append_event(self, goal_id: str, event: dict[str, Any], *, tenant_ctx: Any) -> int:
+        self.events.append(dict(event))
+        return len(self.events)
+
+    async def list_events(self, goal_id: str, *, tenant_ctx: Any, **_: Any) -> list[dict[str, Any]]:
+        return [dict(e) for e in self.events]
+
+    async def list_events_since(
+        self, goal_id: str, after_sequence: int, limit: int = 100, *, tenant_ctx: Any = None
+    ) -> list[dict[str, Any]]:
+        if self.on_list is not None:
+            hook, self.on_list = self.on_list, None
+            await hook()
+        rows = [{**e, "_seq": i} for i, e in enumerate(self.events, start=1) if i > after_sequence]
+        return rows[:limit]
+
+
+def _record(goal_id: str, status: GoalStatus) -> GoalRecord:
+    return GoalRecord(
+        goal_id=goal_id,
+        goal_text="g",
+        status=status,
+        tenant_id=CTX.tenant_id,
+        priority="normal",
+        dry_run=False,
+        created_at=datetime.now(UTC).isoformat(),
+    )
+
+
+async def _drain(gen: Any) -> list[dict[str, Any]]:
+    return [e async for e in gen if e.get("type") != "_sse_heartbeat"]
+
+
+async def test_local_resume_pages_through_the_whole_history() -> None:
+    store = _Store(300)
