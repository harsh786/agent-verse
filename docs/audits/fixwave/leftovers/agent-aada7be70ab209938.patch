diff --git a/agent-verse-backend/tests/scaling/test_mcp_health_registry.py b/agent-verse-backend/tests/scaling/test_mcp_health_registry.py
new file mode 100644
index 000000000..6ac574f08
--- /dev/null
+++ b/agent-verse-backend/tests/scaling/test_mcp_health_registry.py
@@ -0,0 +1,167 @@
+"""RV-03: the connector health beat enumerates the durable (Postgres) registry.
+
+Since MCPREG-01 nothing writes ``mcp:servers:{t}:{id}`` any more, yet
+check_mcp_health scanned only those legacy Redis keys: every connector created
+after the cutover was never probed (empty health history) while stale legacy
+keys kept being probed. The beat now pages ``mcp_servers`` through the
+maintenance session (keyset on (tenant_id, id), bounded per tick, resumable
+cursor) and is guarded so 30 s ticks cannot overlap.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+
+import httpx
+import pytest
+
+from app.mcp.connector_health import HealthTarget
+
+
+def _target(tenant: str, sid: str, host: int) -> HealthTarget:
+    return HealthTarget(
+        tenant_id=tenant,
+        server_id=sid,
+        config={"server_id": sid, "name": f"n-{sid}", "url": f"https://93.184.216.{host}"},
+    )
+
+
+class _CursorRedis:
+    """Only what the beat may touch: the cursor key. Scanning keys is a failure."""
+
+    def __init__(self) -> None:
+        self.data: dict[str, str] = {}
+
+    async def get(self, key: str) -> str | None:
+        return self.data.get(key)
+
+    async def set(self, key: str, value: str, ex: int | None = None) -> None:
+        self.data[key] = value
+
+    async def delete(self, *keys: str) -> None:
+        for k in keys:
+            self.data.pop(k, None)
+
+    async def scan_iter(self, **kw: Any) -> Any:
+        raise AssertionError("the health beat must not scan legacy mcp:servers:* keys")
+        yield  # pragma: no cover
+
+    async def aclose(self) -> None:
+        return None
+
+
+def _install(
+    monkeypatch: pytest.MonkeyPatch,
+    targets: list[HealthTarget],
+    *,
+    per_tick: int = 100,
+    code: int = 200,
+    fail_list: bool = False,
+) -> dict[str, Any]:
+    from app.scaling import tasks
+
+    ordered = sorted(targets, key=lambda t: (t.tenant_id, t.server_id))
+    state: dict[str, Any] = {"pages": [], "probed": [], "written": [], "redis": _CursorRedis()}
+
+    async def _list(system_db: Any, *, after: tuple[str, str] | None, limit: int) -> Any:
+        if fail_list:
+            raise RuntimeError("registry down")
+        state["pages"].append((after, limit))
+        rows = [t for t in ordered if after is None or (t.tenant_id, t.server_id) > after]
+        return rows[:limit]
+
+    monkeypatch.setattr("app.mcp.connector_health.list_health_targets", _list)
+    monkeypatch.setattr("app.db.session.get_system_session_factory", lambda: object())
+    monkeypatch.setattr("redis.asyncio.from_url", lambda *a, **k: state["redis"])
+    monkeypatch.setattr(tasks, "_MCP_HEALTH_PER_TICK", per_tick)
+
+    def _handler(req: httpx.Request) -> httpx.Response:
+        state["probed"].append(str(req.url))
+        return httpx.Response(code)
+
+    monkeypatch.setattr(
+        "app.net.ssrf_guard.public_async_client",
+        lambda **kw: httpx.AsyncClient(transport=httpx.MockTransport(_handler), **kw),
+    )
+
+    async def _persist(snaps: list[dict[str, Any]]) -> int:
+        state["written"].extend(snaps)
+        return len(snaps)
+
+    monkeypatch.setattr(tasks, "_persist_health_snapshots", _persist)
+    return state
+
+
+def test_registry_connectors_are_probed_and_snapshotted(monkeypatch: pytest.MonkeyPatch) -> None:
+    from app.scaling import tasks
+
+    state = _install(monkeypatch, [_target("t1", "pg-made", 1), _target("t2", "other", 2)])
+    out = tasks.check_mcp_health.run()
+    assert out["status"] == "ok"
+    assert out["servers_checked"] == 2
+    assert sorted(state["probed"]) == [
+        "https://93.184.216.1/health",
+        "https://93.184.216.2/health",
+    ]
+    assert {(s["tenant_id"], s["server_id"], s["status"]) for s in state["written"]} == {
+        ("t1", "pg-made", "healthy"),
+        ("t2", "other", "healthy"),
+    }
+
+
+def test_builtin_and_urlless_targets_are_not_probed(monkeypatch: pytest.MonkeyPatch) -> None:
+    from app.scaling import tasks
+
+    builtin = HealthTarget("t1", "builtin-x", {"server_id": "builtin-x", "url": "builtin://x"})
+    empty = HealthTarget("t1", "empty", {"server_id": "empty", "url": ""})
+    state = _install(monkeypatch, [builtin, empty, _target("t1", "real", 3)])
+    tasks.check_mcp_health.run()
+    assert state["probed"] == ["https://93.184.216.3/health"]
+
+
+def test_ticks_resume_from_cursor_and_wrap(monkeypatch: pytest.MonkeyPatch) -> None:
+    """Bounded per tick; connectors beyond the first page are checked next tick."""
+    from app.scaling import tasks
+
+    targets = [_target(f"t{i % 2}", f"s{i}", i + 1) for i in range(5)]
+    state = _install(monkeypatch, targets, per_tick=2)
+    seen: list[set[str]] = []
+    for _ in range(4):
+        before = len(state["written"])
+        tasks.check_mcp_health.run()
+        seen.append({s["server_id"] for s in state["written"][before:]})
+    assert [len(s) for s in seen] == [2, 2, 1, 2]
+    assert set().union(*seen[:3]) == {f"s{i}" for i in range(5)}
+    # The 4th tick wrapped back to the start of the keyspace.
+    assert state["pages"][3][0] is None
+    assert seen[3] == seen[0]
+
+
