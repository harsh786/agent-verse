+async def _probe_connector(target: Any) -> tuple[dict[str, Any], dict[str, Any]] | None:
+    """GET ``{base_url}/health`` of one registry connector (None: nothing to probe).
+
+    Returns the summary result and the snapshot row. The URL is the tenant's, so
+    every hop is re-validated and the pinned client dials only the address
+    checked at connect time (SSRF-01: no DNS-rebinding window).
+    """
+    import time as _t
+
+    from app.mcp.registry import MCPServerConfig
+    from app.net.ssrf_guard import public_async_client, request_public
+
+    cfg_data = dict(target.config)
+    cfg_data.setdefault("server_id", target.server_id)
+    try:
+        cfg = MCPServerConfig.model_validate(cfg_data)
+    except Exception as parse_exc:
+        err = str(parse_exc)[:200]
+        result = {"server_id": target.server_id, "status": "parse_error", "error": err}
+        return result, _health_snapshot(target, "parse_error", None, err)
+    base = (cfg.base_url or cfg.url or "").rstrip("/")
+    if not base or base.startswith("builtin://"):
+        return None
+    t0 = _t.monotonic()
+    latency: int | None
+    try:
+        async with public_async_client(timeout=5.0) as client:
+            resp = await request_public(client, "GET", f"{base}/health", context="mcp health check")
+        health = _classify_health(resp.status_code)
+        latency = round((_t.monotonic() - t0) * 1000)
+        error = None if health == "healthy" else f"HTTP {resp.status_code}"
+        result = {
+            "server": cfg.name,
+            "status": health,
+            "code": resp.status_code,
+            "latency_ms": latency,
+        }
+    except Exception as http_exc:
+        health, latency, error = "unreachable", None, str(http_exc)[:200]
+        result = {"server": cfg.name, "status": "unreachable", "error": error}
+    return result, _health_snapshot(target, health, latency, error)
+
