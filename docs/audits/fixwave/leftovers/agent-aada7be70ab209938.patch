--- /dev/null
+++ b/agent-verse-backend/app/mcp/connector_health.py
@@ -0,0 +1,119 @@
+"""Which connectors the health beat probes, read from the durable registry (RV-03).
+
+Since MCPREG-01 the registry's source of truth is Postgres ``mcp_servers``;
+nothing writes the legacy ``mcp:servers:{tenant}:{id}`` Redis keys any more, so
+a health beat that scanned them never saw a connector created after the
+cutover (and kept probing stale configs). The beat now pages ``mcp_servers``
+across tenants through the maintenance (BYPASSRLS) session:
+
+* keyset on ``(tenant_id, id)`` with the probe filter matching the partial
+  index ``ix_mcp_servers_health_probe`` exactly, so a page costs O(limit) even
+  with millions of built-in (``builtin://``) rows that are never probed;
+* bounded per tick, with the position kept in Redis (``CURSOR_KEY``) so the
+  next tick resumes where this one stopped and connectors beyond the first page
+  are checked; a short page means the end of the keyspace and the cursor wraps.
+
+The cursor is soft state: if it is lost the next tick starts from the
+beginning, which only delays (never skips) a connector's check.
+"""
+
+from __future__ import annotations
+
+import json
+import logging
+from collections.abc import Callable
+from dataclasses import dataclass
+from typing import Any
+
+_log = logging.getLogger(__name__)
+
+CURSOR_KEY = "mcp:health:cursor:v1"
+# Kept identical to the partial index predicate (migration b3d9f1a7c2e5).
+PROBE_FILTER = "enabled AND status <> 'removed' AND url <> '' AND url NOT LIKE 'builtin://%'"
+_CURSOR_TTL_S = 7 * 86400
+
+
+@dataclass(frozen=True)
+class HealthTarget:
+    tenant_id: str
+    server_id: str
+    config: dict[str, Any]
+
+
+def _as_dict(value: Any) -> dict[str, Any]:
+    if isinstance(value, dict):
+        return value
+    try:
+        parsed = json.loads(value)
+    except (TypeError, ValueError):
+        return {}
+    return parsed if isinstance(parsed, dict) else {}
+
+
+async def list_health_targets(
+    system_db: Callable[[], Any], *, after: tuple[str, str] | None, limit: int
+) -> list[HealthTarget]:
+    """One keyset page of probe-able connectors across all tenants (raises on DB errors)."""
+    from sqlalchemy import text
+
+    from app.db.rls import system_session
+
+    params: dict[str, Any] = {"lim": int(limit)}
+    position = ""
+    if after is not None:
+        position = "AND (tenant_id, id) > (:after_t, :after_id) "
+        params.update(after_t=after[0], after_id=after[1])
+    sql = (
+        f"SELECT tenant_id, id, config FROM mcp_servers WHERE {PROBE_FILTER} "
+        f"{position}ORDER BY tenant_id, id LIMIT :lim"
+    )
+    async with system_db() as session, session.begin(), system_session(session):
+        rows = (await session.execute(text(sql), params)).fetchall()
+    return [HealthTarget(str(r[0]), str(r[1]), _as_dict(r[2])) for r in rows]
+
+
+async def load_cursor(redis: Any) -> tuple[str, str] | None:
+    """The position the previous tick stopped at (None: start of the keyspace)."""
+    if redis is None:
+        return None
+    try:
+        raw = await redis.get(CURSOR_KEY)
+        if not raw:
+            return None
+        value = json.loads(raw.decode() if isinstance(raw, bytes) else raw)
+        if isinstance(value, list) and len(value) == 2 and all(isinstance(v, str) for v in value):
+            return value[0], value[1]
+    except Exception as exc:
+        _log.warning("mcp_health_cursor_read_failed: %s", type(exc).__name__)
+    return None
+
+
+async def save_cursor(redis: Any, cursor: tuple[str, str] | None) -> None:
+    """Record where the next tick resumes (None: wrap to the start)."""
+    if redis is None:
+        return
+    try:
+        if cursor is None:
+            await redis.delete(CURSOR_KEY)
+        else:
+            await redis.set(CURSOR_KEY, json.dumps(list(cursor)), ex=_CURSOR_TTL_S)
+    except Exception as exc:
+        _log.warning("mcp_health_cursor_write_failed: %s", type(exc).__name__)
+
+
+def next_cursor(page: list[HealthTarget], limit: int) -> tuple[str, str] | None:
+    """A full page continues after its last row; a short page wraps."""
+    if len(page) < limit or not page:
+        return None
+    return page[-1].tenant_id, page[-1].server_id
+
+
+__all__ = [
+    "CURSOR_KEY",
+    "PROBE_FILTER",
+    "HealthTarget",
+    "list_health_targets",
+    "load_cursor",
+    "next_cursor",
+    "save_cursor",
+]
