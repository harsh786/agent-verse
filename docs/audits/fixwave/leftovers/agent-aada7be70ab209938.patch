+"""RV-03 on real Postgres + Redis: the health beat probes registry connectors.
+
+A connector created through the durable registry (MCPREG-01, Postgres only, no
+legacy ``mcp:servers:*`` key) is probed by ``check_mcp_health`` and a
+``connector_health_snapshots`` row is written under the tenant's RLS; stale
+legacy Redis keys, built-in and disabled rows are not probed; the per-tick
+bound plus the Redis cursor reach every connector across ticks; and the page
+query uses the partial index.
+
+Run with:
+    DOCKER_HOST=unix:///Users/harsh/.colima/default/docker.sock \
+    TESTCONTAINERS_RYUK_DISABLED=true \
+        uv run pytest tests/scaling/test_mcp_health_registry_integration.py -q -m integration
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import secrets
+import uuid
+from collections.abc import Iterator
+from types import SimpleNamespace
+from typing import Any
+
+import httpx
+import pytest
+from sqlalchemy import text
+from sqlalchemy.engine import make_url
+from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine
+from sqlalchemy.pool import NullPool
+
+from app.mcp.registry import MCPRegistry, MCPServerConfig
+from app.tenancy.context import PlanTier, TenantContext
+
+pytestmark = pytest.mark.integration
+
+_TABLES = (
+    "mcp_servers",
+    "mcp_credentials",
+    "mcp_builtin_provisioning",
+    "connector_store_backfills",
+    "connector_health_snapshots",
+)
+
+
+def _ctx(tid: str) -> TenantContext:
+    return TenantContext(tenant_id=tid, plan=PlanTier.PROFESSIONAL, api_key_id="k")
+
+
+@pytest.fixture
+def env(pg_url: str, redis_url: str, monkeypatch: pytest.MonkeyPatch) -> Iterator[Any]:
+    password = secrets.token_urlsafe(24)
+    role = f"test_app_health_{secrets.token_hex(4)}"
+    # NullPool: the task runs on its own fresh event loop (run_in_fresh_loop).
+    admin = create_async_engine(pg_url, poolclass=NullPool)
+
+    async def _setup() -> None:
+        async with admin.begin() as conn:
+            quoted = (
+                await conn.execute(text("SELECT quote_literal(:p)"), {"p": password})
+            ).scalar()
+            await conn.execute(
+                text(
+                    f"CREATE ROLE {role} LOGIN PASSWORD {quoted} "
+                    "NOSUPERUSER NOCREATEDB NOCREATEROLE NOBYPASSRLS"
+                )
+            )
+            await conn.execute(text(f"GRANT USAGE ON SCHEMA public TO {role}"))
+            for table in _TABLES:
+                await conn.execute(
+                    text(f"GRANT SELECT, INSERT, UPDATE, DELETE ON {table} TO {role}")
+                )
+                await conn.execute(text(f"DELETE FROM {table}"))
+            await conn.execute(
+                text(
+                    "INSERT INTO connector_store_backfills (name) VALUES "
+                    "('connector_redis_to_postgres_v1') ON CONFLICT DO NOTHING"
+                )
+            )
+        import redis.asyncio as aioredis
+
+        r = aioredis.from_url(redis_url, decode_responses=True)
+        await r.flushall()
+        await r.aclose()
+
+    asyncio.run(_setup())
+    url = make_url(pg_url).set(username=role, password=password)
+    app_engine = create_async_engine(url.render_as_string(hide_password=False), poolclass=NullPool)
+    app_db = async_sessionmaker(app_engine, expire_on_commit=False)
+    system_db = async_sessionmaker(admin, expire_on_commit=False)  # superuser: BYPASSRLS
+
+    monkeypatch.setattr("app.db.session.get_session_factory", lambda: app_db)
+    monkeypatch.setattr("app.db.session.get_system_session_factory", lambda: system_db)
+    monkeypatch.setenv("REDIS_URL", redis_url)
+    probed: list[str] = []
+
+    def _handler(req: httpx.Request) -> httpx.Response:
+        probed.append(req.url.host)
+        return httpx.Response(200 if req.url.host.endswith(".1") else 503)
+
+    monkeypatch.setattr(
+        "app.net.ssrf_guard.public_async_client",
+        lambda **kw: httpx.AsyncClient(transport=httpx.MockTransport(_handler), **kw),
+    )
+    try:
+        yield SimpleNamespace(
+            app_db=app_db, system_db=system_db, redis_url=redis_url, probed=probed
+        )
+    finally:
+        asyncio.run(app_engine.dispose())
+        asyncio.run(admin.dispose())
+
+
+def _create(env: Any, tid: str, name: str, host: str) -> str:
+    async def _go() -> str:
+        import redis.asyncio as aioredis
+
+        r = aioredis.from_url(env.redis_url, decode_responses=True)
+        try:
+            reg = MCPRegistry(r, db_factory=env.app_db)
+            return await reg.create(
+                MCPServerConfig(name=name, url=f"https://{host}/mcp"), tenant_ctx=_ctx(tid)
+            )
+        finally:
+            await r.aclose()
+
+    return asyncio.run(_go())
+
+
+def _sql(env: Any, sql: str, params: dict[str, Any] | None = None) -> list[Any]:
+    async def _go() -> list[Any]:
+        async with env.system_db() as s, s.begin():
+            result = await s.execute(text(sql), params or {})
+            return list(result.fetchall()) if result.returns_rows else []
+
+    return asyncio.run(_go())
+
+
+def test_registry_connector_is_probed_and_snapshot_written(env: Any) -> None:
+    from app.scaling import tasks
+
+    tid = f"t-{uuid.uuid4().hex[:8]}"
+    sid = _create(env, tid, "Orders API", "93.184.216.1")
+    # Rows the beat must NOT probe: disabled, built-in, removed.
+    for rid, url, enabled, status in (
+        ("off", "https://93.184.216.7/mcp", False, "active"),
+        ("builtin-x", "builtin://x", True, "active"),
+        ("gone", "https://93.184.216.8/mcp", True, "removed"),
+    ):
+        _sql(
+            env,
+            "INSERT INTO mcp_servers (tenant_id, id, name, name_key, url, enabled, status, "
+            "config) VALUES (:t, :id, :id, :id, :url, :en, :st, CAST(:cfg AS jsonb))",
+            {
+                "t": tid,
+                "id": rid,
+                "url": url,
+                "en": enabled,
+                "st": status,
+                "cfg": json.dumps({"server_id": rid, "name": rid, "url": url}),
+            },
+        )
+
+    # A stale legacy Redis config (nothing writes these since MCPREG-01).
+    async def _legacy() -> None:
+        import redis.asyncio as aioredis
+
+        r = aioredis.from_url(env.redis_url, decode_responses=True)
+        stale = MCPServerConfig(server_id="stale", name="stale", url="https://93.184.216.9")
+        await r.set(f"mcp:servers:{tid}:stale", stale.model_dump_json())
+        await r.aclose()
+
+    asyncio.run(_legacy())
+
+    out = tasks.check_mcp_health.run()
+
+    assert out["status"] == "ok", out
+    assert env.probed == ["93.184.216.1"]
+    rows = _sql(
+        env,
+        "SELECT tenant_id, server_id, status FROM connector_health_snapshots WHERE tenant_id = :t",
+        {"t": tid},
+    )
+    assert [tuple(r) for r in rows] == [(tid, sid, "healthy")]
+
+
+def test_bounded_ticks_resume_from_cursor_and_reach_every_connector(
+    env: Any, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from app.scaling import tasks
+
+    monkeypatch.setattr(tasks, "_MCP_HEALTH_PER_TICK", 2)
+    created = {
+        _create(env, f"t{i % 2}-{uuid.uuid4().hex[:4]}", f"Conn {i}", f"93.184.216.{10 + i}")
+        for i in range(5)
+    }
+    per_tick: list[int] = []
+    for _ in range(3):
+        before = len(env.probed)
+        out = tasks.check_mcp_health.run()
+        assert out["status"] == "ok", out
+        per_tick.append(len(env.probed) - before)
+    assert per_tick == [2, 2, 1]
+    assert sorted(env.probed) == sorted(f"93.184.216.{10 + i}" for i in range(5))
+    snap_ids = {r[0] for r in _sql(env, "SELECT server_id FROM connector_health_snapshots")}
+    assert snap_ids == created
+
+    out = tasks.check_mcp_health.run()  # wrapped: starts again from the first page
+    assert out["page_size"] == 2 and len(env.probed) == 7
+
+
+def test_health_page_uses_partial_index(env: Any) -> None:
+    from app.mcp.connector_health import PROBE_FILTER
+
+    async def _plan() -> str:
+        async with env.system_db() as s, s.begin():
+            await s.execute(text("SET LOCAL enable_seqscan = off"))
+            rows = (
+                await s.execute(
+                    text(
+                        f"EXPLAIN SELECT tenant_id, id, config FROM mcp_servers "
+                        f"WHERE {PROBE_FILTER} AND (tenant_id, id) > ('a', 'b') "
+                        "ORDER BY tenant_id, id LIMIT 200"
+                    )
+                )
+            ).fetchall()
+        return "\n".join(r[0] for r in rows)
+
+    plan = asyncio.run(_plan())
+    assert "ix_mcp_servers_health_probe" in plan, plan
