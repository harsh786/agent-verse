+"""mcp_servers: partial index for the connector health beat (RV-03)
+
+The health beat now pages the durable registry across tenants
+(``WHERE <probe filter> AND (tenant_id, id) > (:t, :id) ORDER BY tenant_id, id
+LIMIT n``). Every tenant also holds built-in (``builtin://``) rows that are
+never probed; on the primary key alone a page would walk all of them. This
+partial index holds only probe-able rows, so a page costs O(n). Its predicate
+must stay identical to ``app.mcp.connector_health.PROBE_FILTER``.
+
+Built CONCURRENTLY (outside the migration transaction) so the table is not
+write-locked during the build.
+
+Revision ID: b3d9f1a7c2e5
+Revises: f1e790b4050a
+Create Date: 2026-10-05
+"""
+
+from __future__ import annotations
+
+from collections.abc import Sequence
+
+from alembic import op
+
+revision: str = "b3d9f1a7c2e5"
+down_revision: str | None = "f1e790b4050a"
+branch_labels: str | Sequence[str] | None = None
+depends_on: str | Sequence[str] | None = None
+
+
+def upgrade() -> None:
+    with op.get_context().autocommit_block():
+        op.execute(
+            "CREATE INDEX CONCURRENTLY IF NOT EXISTS ix_mcp_servers_health_probe "
+            "ON mcp_servers (tenant_id, id) "
+            "WHERE enabled AND status <> 'removed' AND url <> '' "
+            "AND url NOT LIKE 'builtin://%'"
+        )
+
+
+def downgrade() -> None:
+    with op.get_context().autocommit_block():
+        op.execute("DROP INDEX CONCURRENTLY IF EXISTS ix_mcp_servers_health_probe")
