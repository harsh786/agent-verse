+                    "gdpr_export_mark_failed_failed job=%s tenant=%s: %s",
+                    job_id,
+                    tenant_id,
+                    mark_exc,
+                )
             raise
 
     return _run_async(_run())
diff --git a/agent-verse-backend/tests/enterprise/test_gdpr_export_complete.py b/agent-verse-backend/tests/enterprise/test_gdpr_export_complete.py
new file mode 100644
index 000000000..9ed10e257
--- /dev/null
+++ b/agent-verse-backend/tests/enterprise/test_gdpr_export_complete.py
@@ -0,0 +1,197 @@
+"""RV-08: a GDPR export is ``ready`` only when every section was fully read.
+
+It used to be ``ready`` before collection started, with a goal read error only
+logged, audit entries capped at 100, agents/schedules from process caches and
+knowledge collections hard-coded ``[]``; the async job stopped at LIMIT 10000
+and swallowed audit read errors.
+"""
+
+from __future__ import annotations
+
+from typing import Any
+from unittest.mock import patch
+
+import pytest
+from fastapi import FastAPI
+from fastapi.testclient import TestClient
+
+from app.enterprise import gdpr_export
+from app.enterprise.compliance import ComplianceController
+from app.tenancy.context import PlanTier, TenantContext
+
+T = TenantContext(tenant_id="gdpr-t1", plan=PlanTier.ENTERPRISE, api_key_id="k1")
+
+_PROFILE = {
+    "tenant_id": T.tenant_id,
+    "name": "n",
+    "email": "e@x",
+    "plan": "enterprise",
+    "created_at": None,
+}
+
+
+def _rows(section: str, n: int) -> list[dict[str, Any]]:
+    return [{"id": f"{section}-{i:05d}"} for i in range(n)]
+
+
+class _FakeTables:
+    """Serves _read_page from in-memory rows, honouring the keyset + limit."""
+
+    def __init__(self, sizes: dict[str, int], fail: str | None = None) -> None:
+        self.tables = {s.name: _rows(s.name, sizes.get(s.name, 0)) for s in gdpr_export.SECTIONS}
+        self.fail = fail
+        self.calls: list[tuple[str, str | None, int]] = []
+
+    async def read_page(
+        self, db: Any, tenant_id: str, section: Any, after: str | None, page_size: int
+    ) -> list[dict[str, Any]]:
+        self.calls.append((section.name, after, page_size))
+        if section.name == self.fail:
+            raise RuntimeError("relation is unreadable")
+        rows = [r for r in self.tables[section.name] if after is None or r["id"] > after]
+        return rows[:page_size]
+
+
+async def _profile(db: Any, tenant_id: str) -> dict[str, Any]:
+    return dict(_PROFILE)
+
+
+async def test_every_row_of_every_section_is_exported_across_pages() -> None:
+    fake = _FakeTables({"goals": 7, "audit_entries": 250, "knowledge_collections": 2, "agents": 3})
+    with (
+        patch.object(gdpr_export, "_read_page", side_effect=fake.read_page),
+        patch.object(gdpr_export, "_read_profile", side_effect=_profile),
+    ):
+        payload = await gdpr_export.collect_tenant_export(object(), T.tenant_id, page_size=3)
+    data = payload["data"]
+    assert len(data["goals"]) == 7
+    assert len(data["audit_entries"]) == 250  # no 100-row cap
+    assert [c["id"] for c in data["knowledge_collections"]] == [
+        "knowledge_collections-00000",
+        "knowledge_collections-00001",
+    ]
+    assert payload["counts"]["audit_entries"] == 250
+    assert payload["complete"] is True and payload["truncated"] is False
+    # Keyset pagination: each page continues after the previous page's last id.
+    goal_calls = [c for c in fake.calls if c[0] == "goals"]
+    assert goal_calls == [
+        ("goals", None, 3),
+        ("goals", "goals-00002", 3),
+        ("goals", "goals-00005", 3),
+    ]
+
+
+async def test_section_read_error_raises_with_the_section() -> None:
+    fake = _FakeTables({"goals": 5}, fail="knowledge_collections")
+    with (
+        patch.object(gdpr_export, "_read_page", side_effect=fake.read_page),
+        patch.object(gdpr_export, "_read_profile", side_effect=_profile),
+        pytest.raises(gdpr_export.GdprExportError) as err,
+    ):
+        await gdpr_export.collect_tenant_export(object(), T.tenant_id)
+    assert err.value.section == "knowledge_collections"
+    assert "relation is unreadable" in err.value.reason
+
+
+async def test_no_database_is_an_error_not_an_empty_export() -> None:
+    with pytest.raises(gdpr_export.GdprExportError):
+        await gdpr_export.collect_tenant_export(None, T.tenant_id)
+
+
+# ── ComplianceController (sync path) ─────────────────────────────────────────
+
+
+class _Saved:
+    def __init__(self) -> None:
+        self.states: list[tuple[str, bool]] = []
+
+    async def save(self, req: Any, *, strict: bool = False) -> None:
+        self.states.append((req.status, strict))
+
+
+async def test_controller_failed_section_yields_failed_never_ready() -> None:
+    cc = ComplianceController()
+    cc._db = object()
+    saved = _Saved()
+    fake = _FakeTables({"goals": 5}, fail="goals")
+    with (
+        patch.object(gdpr_export, "_read_page", side_effect=fake.read_page),
+        patch.object(gdpr_export, "_read_profile", side_effect=_profile),
+        patch.object(cc, "_db_save_request", side_effect=saved.save),
+    ):
+        req = await cc.request_data_export(tenant_ctx=T)
+    assert req.status == "failed"
+    assert "goals" in req.payload["error"] and req.payload["failed_section"] == "goals"
+    assert "data" not in req.payload
+    # processing first, then the terminal state persisted strictly; never ready.
+    assert saved.states == [("processing", False), ("failed", True)]
+    assert await cc.get_export_payload(request_id=req.request_id, tenant_ctx=T) is None
+
+
+async def test_controller_ready_only_after_all_sections() -> None:
+    cc = ComplianceController()
+    cc._db = object()
+    saved = _Saved()
+    fake = _FakeTables({"goals": 2, "knowledge_collections": 1})
+    with (
+        patch.object(gdpr_export, "_read_page", side_effect=fake.read_page),
+        patch.object(gdpr_export, "_read_profile", side_effect=_profile),
+        patch.object(cc, "_db_save_request", side_effect=saved.save),
+    ):
+        req = await cc.request_data_export(tenant_ctx=T)
+    assert req.status == "ready"
+    assert saved.states == [("processing", False), ("ready", True)]
+    assert len(req.payload["data"]["knowledge_collections"]) == 1
+    assert {s.name for s in gdpr_export.SECTIONS} <= set(req.payload["data"])
+
+
+async def test_controller_without_database_fails_honestly() -> None:
+    cc = ComplianceController()
+    req = await cc.request_data_export(tenant_ctx=T)
+    assert req.status == "failed"
+    assert "no database" in req.payload["error"]
+
+
+# ── API ──────────────────────────────────────────────────────────────────────
+
+
+def _client(cc: ComplianceController) -> TestClient:
+    from app.api.enterprise import router
+
+    app = FastAPI()
+
+    @app.middleware("http")
+    async def _tenant(request: Any, call_next: Any) -> Any:
+        request.state.tenant = T
+        return await call_next(request)
+
+    app.include_router(router)
+    app.state.compliance_controller = cc
+    return TestClient(app, raise_server_exceptions=False)
+
+
+def test_api_reports_failed_export_without_a_download_link() -> None:
+    cc = ComplianceController()  # no DB -> failed
+    with patch("app.api.enterprise._compliance", return_value=cc):
+        c = _client(cc)
+        r = c.get("/enterprise/compliance/export")
+        assert r.status_code == 200, r.text
+        body = r.json()
+        assert body["status"] == "failed" and body["download_url"] is None
+        assert body["error"]
+        dl = c.get(f"/enterprise/compliance/export/{body['request_id']}/download")
+        assert dl.status_code == 409, dl.text
+
+
+def test_api_503_when_the_result_cannot_be_recorded() -> None:
+    cc = ComplianceController()
+
+    async def _boom(**_kw: Any) -> Any:
+        raise RuntimeError("compliance_requests write failed")
+
+    with (
+        patch.object(cc, "request_data_export", side_effect=_boom),
+        patch("app.api.enterprise._compliance", return_value=cc),
+    ):
+        r = _client(cc).get("/enterprise/compliance/export")
+    assert r.status_code == 503, r.text
diff --git a/agent-verse-backend/tests/enterprise/test_gdpr_export_pg.py b/agent-verse-backend/tests/enterprise/test_gdpr_export_pg.py
new file mode 100644
index 000000000..35cc0a28c
--- /dev/null
+++ b/agent-verse-backend/tests/enterprise/test_gdpr_export_pg.py
@@ -0,0 +1,246 @@
+"""RV-08 (integration): the GDPR export reads every section from Postgres under
+the tenant's RLS (least-privilege NOBYPASSRLS role) with keyset pagination — more
+rows than one page, nothing capped — and a section that cannot be read makes the
+export ``failed`` (never ``ready``/``complete``), on both the Celery job and the
+synchronous controller path.
+
+Run with:
+    DOCKER_HOST=unix:///Users/harsh/.colima/default/docker.sock \\
+    TESTCONTAINERS_RYUK_DISABLED=true \\
+        uv run pytest tests/enterprise/test_gdpr_export_pg.py -q -m integration
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import uuid
+from collections.abc import Iterator
+from typing import Any
+
+import pytest
+from sqlalchemy import text
+from sqlalchemy.engine import make_url
+from sqlalchemy.ext.asyncio import async_sessionmaker, create_async_engine
+from sqlalchemy.pool import NullPool
+from testcontainers.postgres import PostgresContainer  # type: ignore[import-untyped]
+
+from tests.memory._pg import alembic_upgrade, app_role_engine
+
+pytestmark = pytest.mark.integration
+
+TENANT = "gdpr-pg-tenant"
+OTHER = "gdpr-pg-other"
+PAGE = 50
+EXPECTED = {
+    "goals": 120,
+    "audit_entries": 130,
+    "agents": 3,
+    "schedules": 2,
+    "knowledge_collections": 2,
+    "api_keys": 1,
+}
+TABLES = [
+    "compliance_requests",
+    "gdpr_export_jobs",
+    "goals",
+    "audit_log",
+    "agents",
+    "schedules",
+    "knowledge_collections",
+    "api_keys",
+    "tenants",
+]
+
+
+async def _seed(admin: str) -> None:
+    eng = create_async_engine(admin, poolclass=NullPool)
+    async with eng.begin() as c:
+        for t, scale in ((TENANT, 1), (OTHER, 0)):
+            p = t[-5:]
+            await c.execute(
+                text("INSERT INTO tenants (id, name, email) VALUES (:t, :t, :e)"),
+                {"t": t, "e": f"{t}@example.test"},
+            )
+            n_goals = EXPECTED["goals"] if scale else 5
+            await c.execute(
+                text(
+                    "INSERT INTO goals (id, tenant_id, goal_text) "
+                    "SELECT :p || '-g' || lpad(g::text, 5, '0'), :t, 'goal ' || g "
+                    "FROM generate_series(1, :n) g"
+                ),
+                {"p": p, "t": t, "n": n_goals},
+            )
+            await c.execute(
+                text(
+                    "INSERT INTO audit_log (id, tenant_id, goal_id, tool_name, action_level, "
+                    "outcome) SELECT :p || '-a' || lpad(g::text, 5, '0'), :t, 'g', 'tool', "
+                    "'allow', 'success' FROM generate_series(1, :n) g"
+                ),
+                {"p": p, "t": t, "n": EXPECTED["audit_entries"] if scale else 5},
+            )
+            await c.execute(
+                text(
+                    "INSERT INTO agents (id, tenant_id, name) "
+                    "SELECT :p || '-ag' || g, :t, 'agent ' || g FROM generate_series(1, :n) g"
+                ),
+                {"p": p, "t": t, "n": EXPECTED["agents"] if scale else 1},
+            )
+            await c.execute(
+                text(
+                    "INSERT INTO schedules (id, tenant_id, goal_id_template, trigger_type, "
+                    "cron_expression, interval_seconds, config, paused) "
+                    "SELECT :p || '-s' || g, :t, 'x', 'cron', '0 9 * * *', 0, '{}'::jsonb, "
+                    "false FROM generate_series(1, :n) g"
+                ),
+                {"p": p, "t": t, "n": EXPECTED["schedules"] if scale else 1},
+            )
+            await c.execute(
+                text(
+                    "INSERT INTO knowledge_collections (id, tenant_id, name) "
+                    "SELECT :p || '-kc' || g, :t, 'coll ' || g FROM generate_series(1, :n) g"
+                ),
+                {"p": p, "t": t, "n": EXPECTED["knowledge_collections"] if scale else 1},
+            )
+            await c.execute(
+                text(
+                    "INSERT INTO api_keys (id, tenant_id, name, key_hash) "
+                    "VALUES (:kid, :t, 'k', :h)"
+                ),
+                {"kid": f"{p}-key", "t": t, "h": (t * 64)[:64]},
+            )
+    await eng.dispose()
+
+
+@pytest.fixture(scope="module")
+def urls() -> Iterator[tuple[str, str, str]]:
+    with PostgresContainer("pgvector/pgvector:pg16", driver="asyncpg") as pg:
+        admin = pg.get_connection_url()
+        alembic_upgrade(admin)
+        loop = asyncio.new_event_loop()
+        engine = loop.run_until_complete(app_role_engine(admin, TABLES))
+        app_url = engine.url.render_as_string(hide_password=False)
+        loop.run_until_complete(engine.dispose())
+        loop.run_until_complete(_seed(admin))
+        loop.close()
+        role = make_url(app_url).username or ""
+        yield admin, app_url, role
+
+
+def _factory(url: str) -> Any:
+    return async_sessionmaker(create_async_engine(url, poolclass=NullPool), expire_on_commit=False)
+
+
+async def _admin(admin_url: str, sql: str, params: dict[str, Any] | None = None) -> list[Any]:
+    eng = create_async_engine(admin_url, poolclass=NullPool)
+    async with eng.begin() as c:
+        result = await c.execute(text(sql), params or {})
+        rows = list(result.fetchall()) if result.returns_rows else []
+    await eng.dispose()
+    return rows
+
+
+async def _new_job(admin_url: str) -> str:
+    job_id = uuid.uuid4().hex
+    await _admin(
+        admin_url,
+        "INSERT INTO gdpr_export_jobs (id, tenant_id, status, created_at) "
+        "VALUES (:id, :t, 'pending', NOW())",
+        {"id": job_id, "t": TENANT},
+    )
+    return job_id
+
+
+def _payload(raw: Any) -> dict[str, Any]:
+    return raw if isinstance(raw, dict) else json.loads(raw)
+
+
+def _assert_complete(payload: dict[str, Any]) -> None:
+    data = payload["data"]
+    for section, n in EXPECTED.items():
+        assert len(data[section]) == n, (section, len(data[section]))
+        assert all(not str(r["id"]).startswith("other") for r in data[section]), section
+    assert payload["counts"] == EXPECTED
+    assert data["tenant_profile"]["email"] == f"{TENANT}@example.test"
+    assert "key_hash" not in data["api_keys"][0]
+    ids = [r["id"] for r in data["goals"]]
+    assert ids == sorted(ids) and len(set(ids)) == len(ids)  # keyset: no dupes/gaps
+
+
+def test_celery_and_sync_exports_are_complete_across_pages(
+    urls: tuple[str, str, str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from app.enterprise import gdpr_export
+    from app.enterprise.compliance import ComplianceController
+    from app.scaling import tasks
+    from app.tenancy.context import PlanTier, TenantContext
+
+    admin_url, app_url, _ = urls
+    monkeypatch.setattr(gdpr_export, "DEFAULT_PAGE_SIZE", PAGE)  # 120 goals = 3 pages
+    monkeypatch.setattr("app.db.session.get_session_factory", lambda: _factory(app_url))
+
+    job_id = asyncio.run(_new_job(admin_url))
+    result = tasks.run_gdpr_export.run(job_id, TENANT)
+    assert result["status"] == "complete"
+    (job,) = asyncio.run(
+        _admin(admin_url, "SELECT status, error_message FROM gdpr_export_jobs WHERE id = :id",
+               {"id": job_id})
+    )
+    assert job[0] == "complete" and job[1] is None
+    (req,) = asyncio.run(
+        _admin(admin_url, "SELECT status, payload FROM compliance_requests WHERE request_id = :id",
+               {"id": job_id})
+    )
+    assert req[0] == "ready"
+    _assert_complete(_payload(req[1]))
+
+    cc = ComplianceController()
+    cc._db = _factory(app_url)
+    ctx = TenantContext(tenant_id=TENANT, plan=PlanTier.ENTERPRISE, api_key_id="k")
+    sync = asyncio.run(cc.request_data_export(tenant_ctx=ctx))
+    assert sync.status == "ready"
+    _assert_complete(sync.payload)
+    (stored,) = asyncio.run(
+        _admin(admin_url, "SELECT status FROM compliance_requests WHERE request_id = :id",
+               {"id": sync.request_id})
+    )
+    assert stored[0] == "ready"
+
+
+def test_unreadable_section_fails_the_export(
+    urls: tuple[str, str, str], monkeypatch: pytest.MonkeyPatch
+) -> None:
+    from app.enterprise.compliance import ComplianceController
+    from app.scaling import tasks
+    from app.tenancy.context import PlanTier, TenantContext
+
+    admin_url, app_url, role = urls
+    monkeypatch.setattr("app.db.session.get_session_factory", lambda: _factory(app_url))
+    asyncio.run(_admin(admin_url, f"REVOKE SELECT ON knowledge_collections FROM {role}"))
+    try:
+        job_id = asyncio.run(_new_job(admin_url))
+        with pytest.raises(Exception, match="knowledge_collections"):
+            tasks.run_gdpr_export.run(job_id, TENANT)
+        (job,) = asyncio.run(
+            _admin(admin_url, "SELECT status, error_message FROM gdpr_export_jobs WHERE id = :id",
+                   {"id": job_id})
+        )
+        assert job[0] == "failed" and "knowledge_collections" in job[1]
+        assert asyncio.run(
+            _admin(admin_url, "SELECT 1 FROM compliance_requests WHERE request_id = :id",
+                   {"id": job_id})
+        ) == []
+
+        cc = ComplianceController()
+        cc._db = _factory(app_url)
+        ctx = TenantContext(tenant_id=TENANT, plan=PlanTier.ENTERPRISE, api_key_id="k")
+        sync = asyncio.run(cc.request_data_export(tenant_ctx=ctx))
+        assert sync.status == "failed"
+        assert sync.payload["failed_section"] == "knowledge_collections"
+        (stored,) = asyncio.run(
+            _admin(admin_url, "SELECT status, payload FROM compliance_requests "
+                   "WHERE request_id = :id", {"id": sync.request_id})
+        )
+        assert stored[0] == "failed" and "data" not in _payload(stored[1])
+    finally:
+        asyncio.run(_admin(admin_url, f"GRANT SELECT ON knowledge_collections TO {role}"))
