diff --git a/agent-verse-backend/app/enterprise/gdpr_export.py b/agent-verse-backend/app/enterprise/gdpr_export.py
new file mode 100644
index 000000000..8527eb346
--- /dev/null
+++ b/agent-verse-backend/app/enterprise/gdpr_export.py
@@ -0,0 +1,262 @@
+"""Complete GDPR access/portability export, read from Postgres (RV-08).
+
+Used by both the synchronous ``GET /enterprise/compliance/export`` path
+(``ComplianceController.request_data_export``) and the async Celery job
+(``run_gdpr_export``). The export used to be reported ``ready`` while data was
+missing: goal read errors were only logged, audit entries were capped at 100
+(and the async job queried a non-existent ``audit_log.event_id`` column and
+swallowed the error, so it never exported any), agents/schedules came from
+this replica's in-memory cache, knowledge collections were hard-coded ``[]``
+and the async job silently stopped at ``LIMIT 10000``.
+
+Now every section is read from Postgres under the tenant's RLS with keyset
+pagination (``WHERE id > :after ORDER BY id LIMIT :page``) — no cap, nothing
+dropped — and ANY section read error raises :class:`GdprExportError`, which
+callers turn into a ``failed`` export carrying the reason. Only a fully read
+export is ever ``ready``. Secrets are never exported (no key hashes, webhook
+tokens or signing secrets).
+"""
+
+from __future__ import annotations
+
+from dataclasses import dataclass
+from datetime import UTC, date, datetime
+from decimal import Decimal
+from typing import Any
+
+from app.observability.logging import get_logger
+
+_log = get_logger(__name__)
+
+EXPORT_FORMAT_VERSION = "2.0"
+DEFAULT_PAGE_SIZE = 1000
+
+
+class GdprExportError(RuntimeError):
+    """A section of the export could not be read; the export must be ``failed``."""
+
+    def __init__(self, section: str, reason: str) -> None:
+        super().__init__(f"GDPR export section '{section}' could not be read: {reason}")
+        self.section = section
+        self.reason = reason
+
+
+@dataclass(frozen=True)
+class _Section:
+    name: str
+    table: str
+    columns: tuple[str, ...]
+
+
+#: Every tenant-owned section, keyset-paginated on the table's ``id`` key.
+SECTIONS: tuple[_Section, ...] = (
+    _Section(
+        "goals",
+        "goals",
+        (
+            "id",
+            "goal_text",
+            "status",
+            "priority",
+            "agent_id",
+            "workflow_mode",
+            "created_at",
+            "completed_at",
+        ),
+    ),
+    _Section(
+        "audit_entries",
+        "audit_log",
+        (
+            "id",
+            "goal_id",
+            "tool_name",
+            "action_level",
+            "outcome",
+            "step_id",
+            "approver",
+            "note",
+            "api_key_id",
+            "created_at",
+        ),
+    ),
+    _Section(
+        "agents",
+        "agents",
+        ("id", "name", "goal_template", "system_prompt", "created_at", "updated_at"),
+    ),
+    _Section(
+        "schedules",
+        "schedules",
+        (
+            "id",
+            "agent_id",
+            "goal_id_template",
+            "trigger_type",
+            "cron_expression",
+            "timezone",
+            "interval_seconds",
+            "description",
+            "paused",
+            "created_at",
+        ),
+    ),
+    _Section(
+        "knowledge_collections",
+        "knowledge_collections",
+        (
+            "id",
+            "name",
+            "description",
+            "domain",
+            "document_count",
+            "chunk_count",
+            "total_size_bytes",
+            "created_at",
+            "updated_at",
+        ),
+    ),
+    # Key metadata only — never the hash (a key's SHA-256 authenticates as it).
+    _Section(
+        "api_keys",
+        "api_keys",
+        ("id", "name", "scopes", "roles", "is_active", "created_at", "expires_at", "last_used_at"),
+    ),
+)
+
+
+def _jsonable(value: Any) -> Any:
+    if isinstance(value, datetime | date):
+        return value.isoformat()
+    if isinstance(value, Decimal):
+        return float(value)
+    if isinstance(value, tuple):
+        return list(value)
+    return value
+
+
+def _reason(exc: BaseException) -> str:
+    text = str(exc)
+    first = text.splitlines()[0][:200] if text else ""
+    return f"{type(exc).__name__}: {first}" if first else type(exc).__name__
+
+
+async def _read_page(
+    db_factory: Any, tenant_id: str, section: _Section, after: str | None, page_size: int
+) -> list[dict[str, Any]]:
+    from sqlalchemy import text
+
+    from app.db.rls import sqlalchemy_rls_context
+
+    cols = ", ".join(section.columns)
+    keyset = "AND id > :after " if after is not None else ""
+    sql = (
+        f"SELECT {cols} FROM {section.table} WHERE tenant_id = :tid {keyset}"
+        "ORDER BY id LIMIT :lim"
+    )
+    params: dict[str, Any] = {"tid": tenant_id, "lim": page_size}
+    if after is not None:
+        params["after"] = after
+    async with db_factory() as session, session.begin():  # noqa: SIM117
+        async with sqlalchemy_rls_context(session, tenant_id):
+            rows = (await session.execute(text(sql), params)).fetchall()
+    return [
+        {col: _jsonable(val) for col, val in zip(section.columns, row, strict=True)}
+        for row in rows
+    ]
+
+
+async def read_section(
+    db_factory: Any, tenant_id: str, section: _Section, *, page_size: int = DEFAULT_PAGE_SIZE
+) -> list[dict[str, Any]]:
+    """Every row of *section* for the tenant, page by page; raise on any error."""
+    out: list[dict[str, Any]] = []
+    after: str | None = None
+    while True:
+        try:
+            page = await _read_page(db_factory, tenant_id, section, after, page_size)
+        except Exception as exc:
+            _log.error(
+                "gdpr_export_section_failed",
+                tenant_id=tenant_id,
+                section=section.name,
+                rows_read=len(out),
+                error=str(exc)[:500],
+            )
+            raise GdprExportError(section.name, _reason(exc)) from exc
+        out.extend(page)
+        if len(page) < page_size:
+            return out
+        after = str(page[-1]["id"])
+
+
+async def _read_profile(db_factory: Any, tenant_id: str) -> dict[str, Any]:
+    from sqlalchemy import text
+
+    from app.db.rls import sqlalchemy_rls_context
+
+    try:
+        async with db_factory() as session, session.begin():  # noqa: SIM117
+            async with sqlalchemy_rls_context(session, tenant_id):
+                row = (
+                    await session.execute(
+                        text(
+                            "SELECT id, name, email, plan_tier, created_at "
+                            "FROM tenants WHERE id = :tid"
+                        ),
+                        {"tid": tenant_id},
+                    )
+                ).first()
+    except Exception as exc:
+        raise GdprExportError("tenant_profile", _reason(exc)) from exc
+    if row is None:
+        raise GdprExportError("tenant_profile", "tenant record not found")
+    return {
+        "tenant_id": row[0],
+        "name": row[1],
+        "email": row[2],
+        "plan": row[3],
+        "created_at": _jsonable(row[4]),
+    }
+
+
+async def collect_tenant_export(
+    db_factory: Any, tenant_id: str, *, page_size: int | None = None
+) -> dict[str, Any]:
+    """The complete export payload for *tenant_id*; raises :class:`GdprExportError`.
+
+    No database → error (an export from process caches is not the tenant's data).
+    """
+    if db_factory is None:
+        raise GdprExportError("all", "no database configured; nothing can be exported")
+    if page_size is None:
+        page_size = DEFAULT_PAGE_SIZE
+    if page_size < 1:
+        raise ValueError("page_size must be positive")
+    profile = await _read_profile(db_factory, tenant_id)
+    data: dict[str, Any] = {"tenant_profile": profile}
+    counts: dict[str, int] = {}
+    for section in SECTIONS:
+        rows = await read_section(db_factory, tenant_id, section, page_size=page_size)
+        data[section.name] = rows
+        counts[section.name] = len(rows)
+    return {
+        "tenant_id": tenant_id,
+        "plan": profile.get("plan"),
+        "export_timestamp": datetime.now(UTC).isoformat(),
+        "export_format_version": EXPORT_FORMAT_VERSION,
+        "complete": True,
+        "truncated": False,
+        "counts": counts,
+        "data": data,
+    }
+
+
+__all__ = [
+    "DEFAULT_PAGE_SIZE",
+    "EXPORT_FORMAT_VERSION",
+    "SECTIONS",
+    "GdprExportError",
+    "collect_tenant_export",
+    "read_section",
+]
