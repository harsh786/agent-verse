+class _GateRedis:
+    def __init__(self) -> None:
+        self.keys: dict[str, int] = {}
+
+    async def set(self, key: str, value: str, *, nx: bool, ex: int) -> bool:
+        if key in self.keys:
+            return False
+        self.keys[key] = ex
+        return True
+
+    async def aclose(self) -> None:
+        return None
+
+
+async def test_a_sync_schedules_reconciliation_at_most_once_per_interval() -> None:
+    from app.ingestion import scheduler
+
+    gate = _GateRedis()
+    config = SourceConfig(
+        source_id="src-g",
+        tenant_id="t1",
+        name="g",
+        family=SourceFamily.OBJECT_STORAGE,
+        source_type="fake-million",
+        collection_id="c1",
+        connection_config={"reconcile_interval_seconds": 7200},
+    )
+    with (
+        patch.object(scheduler, "_gate_redis", return_value=gate),
+        patch.object(scheduler.reconcile_source_task, "apply_async") as enqueue,
+    ):
+        assert await scheduler._schedule_reconcile_if_due(_MillionBucket(), config) is True
+        assert await scheduler._schedule_reconcile_if_due(_MillionBucket(), config) is False
+    enqueue.assert_called_once()
+    assert enqueue.call_args.kwargs["queue"] == "ingestion"
+    assert enqueue.call_args.kwargs["kwargs"] == {"source_id": "src-g", "tenant_id": "t1"}
+    assert gate.keys == {"ingestion:reconcile:due:t1:src-g": 7200}
+
