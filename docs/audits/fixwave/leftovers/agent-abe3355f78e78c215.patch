+def reconcile_source_task(self: Any, *, source_id: str, tenant_id: str) -> dict:
+    """Upstream-deletion reconciliation for one Source (scheduled by its syncs)."""
+    result = _run_task_loop(_reconcile_source_async(source_id=source_id, tenant_id=tenant_id))
+    if result.get("skipped") == "locked":
+        raise self.retry()  # a sync holds the Source: run once it is done
+    return result
+
