+from tests.rag._pg import admin_exec, app_engine, seed_tenant, sessions
+
+pytestmark = pytest.mark.integration
+
+
+class _Bucket(BaseConnector):
+    source_type = "fake-bucket"
+
+    def __init__(self, keys: list[str]) -> None:
+        self.keys = keys
+
+    async def validate_connection(self, config: SourceConfig) -> ConnectionHealth:
+        return ConnectionHealth(ok=True)
+
+    async def get_delta(
+        self, config: SourceConfig, cursor: str | None
+    ) -> AsyncIterator[tuple[RawDocument, str]]:
+        return
+        yield  # pragma: no cover
+
+    async def iter_live_doc_ids(self, config: SourceConfig) -> AsyncIterator[str]:
+        for key in self.keys:  # listing order is irrelevant to the SQL diff
+            yield f"s3://b/{key}"
+
+    def manages_doc_id(self, doc_id: str) -> bool:
+        return doc_id.startswith("s3://")
+
+
+async def test_staged_listing_diff_deletes_exactly_the_gone_documents(pg_url: str) -> None:
+    tid, other = str(uuid.uuid4()), str(uuid.uuid4())
+    for t in (tid, other):
+        await seed_tenant(pg_url, t)
+    engine = await app_engine(pg_url)
+    try:
+        store = KnowledgeStore(sessions(engine), embedding_dim=768)
+        ctx = TenantContext(tid, PlanTier.FREE, "k")
+        cid = await store.create_collection_async(KnowledgeCollection(name="c"), tenant_ctx=ctx)
+        keys = [f"Doc-{i:03d}" for i in range(40)] + ["ünïcode-ü", "UPPER", "lower"]
+        for key in keys:
+            await store.ingest_chunks_async(
+                [
+                    Chunk(
+                        document_id=f"s3://b/{key}",
+                        content=f"body {key}",
+                        embedding=[0.01] * 768,
+                        chunk_index=0,
+                        metadata={"source_id": "src-1"},
+                    )
+                ],
+                collection_id=cid,
+                tenant_ctx=ctx,
+            )
+        gone = {"Doc-003", "Doc-017", "Doc-029", "ünïcode-ü", "UPPER"}
+        held = "s3://b/Doc-017"
+        await admin_exec(
+            pg_url,
+            "INSERT INTO legal_holds (tenant_id, name, resource_type, resource_ids) "
+            "VALUES (:t, 'm', 'document', CAST(:r AS jsonb))",
+            {"t": tid, "r": json.dumps([held])},
+        )
+        live = [k for k in reversed(keys) if k not in gone]
+        config = SourceConfig(
+            source_id="src-1",
+            tenant_id=tid,
+            name="s",
+            family=SourceFamily.OBJECT_STORAGE,
+            source_type="fake-bucket",
+            collection_id=cid,
+        )
+
+        # Run 1, capped at 2 deletions, small pages/batches to cross boundaries.
+        first = await _reconcile_upstream_deletions(
+            _Bucket(live),
+            config,
+            SimpleNamespace(_kb=store),
+            max_deletes=2,
+            page_size=3,
+            stage_batch=7,
+        )
+        assert first["deleted"] == 2 and first["truncated"] == 1
+        # Run 2 finishes the job; the held document survives every run.
+        second = await _reconcile_upstream_deletions(
+            _Bucket(live), config, SimpleNamespace(_kb=store), page_size=3, stage_batch=7
+        )
+        assert second["deleted"] == 2
+        assert second["kept_held"] == 1
+
+        rows = await admin_exec(
+            pg_url,
+            "SELECT DISTINCT document_id FROM knowledge_chunks_768 WHERE collection_id = :c",
+            {"c": cid},
+        )
+        remaining = {r[0] for r in rows}
+        assert remaining == {f"s3://b/{k}" for k in keys if k not in gone} | {held}
+        # Staging is cleaned up after each run.
+        left = await admin_exec(
+            pg_url,
+            "SELECT count(*) FROM ingestion_live_listings WHERE tenant_id = :t",
+            {"t": tid},
+        )
+        assert int(left[0][0]) == 0
+
+        # RLS: another tenant cannot see a run's staged ids.
+        await store.stage_live_doc_ids_async("run-x", ["s3://b/a"], tenant_ctx=ctx)
+        other_store = KnowledgeStore(sessions(engine), embedding_dim=768)
+        octx = TenantContext(other, PlanTier.FREE, "k")
+        await other_store.clear_live_listing_async("run-x", tenant_ctx=octx)
+        still = await admin_exec(
+            pg_url,
+            "SELECT count(*) FROM ingestion_live_listings WHERE tenant_id = :t AND run_id = 'run-x'",
+            {"t": tid},
+        )
+        assert int(still[0][0]) == 1
+    finally:
+        await engine.dispose()
